---
// Location section — Igreja e Quinta
---

<section id="ceremony" class="wedding-section bg-white">
	<div class="max-w-4xl mx-auto">
		<div class="section-header">
			<p class="section-subtitle">Os detalhes</p>
			<h2 class="section-title">Cerimónia & Copo D'Água</h2>
			<div class="ornament">
				<img src={`/images/TM_LOGO.png`} alt="Logo" class="h-10 w-auto" />
			</div>
		</div>

		<!-- Two locations: Igreja + Quinta -->
		<div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
			<!-- Cerimónia -->
			<div class="wedding-card text-center">
				<div class="text-3xl mb-4">⛪</div>
				<h3 class="text-xl font-light text-gray-900 mb-2" style="font-family: 'Playfair Display', serif;">
					Cerimónia
				</h3>
				<p class="text-sm text-olive-600 font-medium mb-3">Capela Nossa Senhora das Dores - Trofa</p>
				<p class="text-xs text-gray-500 mb-4">Às 12h15</p>
				<a 
					href="https://www.google.com/maps/search/?api=1&query=Capela+Nossa+Senhora+das+Dores+Trofa"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 px-4 py-2 bg-olive-500 hover:bg-olive-600 text-white text-xs font-medium rounded-full transition-colors"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
					</svg>
					Ver no mapa
				</a>
			</div>

			<!-- Copo D'Água -->
			<div class="wedding-card text-center">
				<div class="text-3xl mb-4">🥂</div>
				<h3 class="text-xl font-light text-gray-900 mb-2" style="font-family: 'Playfair Display', serif;">
					Copo D'Água
				</h3>
				<p class="text-sm text-olive-600 font-medium mb-3">Quinta da Lage – Santo Tirso</p>
				<p class="text-xs text-gray-500 mb-4">Até o sol nascer</p>
				<a 
					href="https://www.google.com/maps/search/?api=1&query=Quinta+da+Lage+Santo+Tirso"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 px-4 py-2 bg-olive-500 hover:bg-olive-600 text-white text-xs font-medium rounded-full transition-colors"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
					</svg>
					Ver no mapa
				</a>
			</div>
		</div>

		<!-- Quinta image -->
		<div class="mt-10 rounded-3xl overflow-hidden shadow-sm max-w-2xl mx-auto">
			<img 
				src={`/images/quinta.jpeg`}
				alt="Quinta da Lage - Santo Tirso" 
				class="w-full h-56 md:h-72 object-cover"
				loading="lazy"
			/>
		</div>
	</div>
</section>
