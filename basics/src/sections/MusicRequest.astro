---
// MusicRequest section — Song suggestions for the wedding DJ
---

<section id="music-request" class="wedding-section" style="background-image: url('/casamento_taniaemiguel/images/sand-texture.jpg'); background-size: cover; background-position: center;">
	<div class="max-w-2xl mx-auto">
		<div class="section-header">
			<p class="section-subtitle">Notas e Melodias</p>
			<h2 class="section-title">Um Toque Especial</h2>
			<div class="ornament">
				<img src={`${import.meta.env.BASE_URL}/images/TM_LOGO.png`} alt="Logo" class="h-10 w-auto" />
			</div>
		</div>

		<p class="text-center text-gray-600 text-sm md:text-base mb-8 leading-relaxed max-w-xl mx-auto">
			O nosso dia só fica completo com a tua música favorita. Partilha connosco aquele tema que te traz boas memórias ou que te faz saltar da cadeira e nós tratamos do resto com o DJ.
		</p>

		<div class="wedding-card">
			<form id="music-form" class="space-y-5" autocomplete="on">
				<!-- Nome do Convidado -->
				<div>
					<label for="music-guest-name" class="music-label">Nome do Convidado *</label>
					<input
						type="text"
						id="music-guest-name"
						name="guest_name"
						required
						maxlength="100"
						class="music-input"
						placeholder="O teu nome"
					/>
				</div>

				<!-- Música e Artista -->
				<div>
					<label for="music-song-artist" class="music-label">Música e Artista *</label>
					<input
						type="text"
						id="music-song-artist"
						name="song_artist"
						required
						maxlength="200"
						class="music-input"
						placeholder="Ex: Dancing Queen - ABBA"
					/>
				</div>

				<!-- Submit -->
				<div class="pt-3">
					<button
						type="submit"
						id="music-submit-btn"
						class="w-full py-4 px-6 bg-olive-600 hover:bg-olive-700 text-white text-sm font-medium uppercase tracking-[0.15em] rounded-full transition-all duration-300 hover:shadow-lg flex items-center justify-center gap-2"
					>
						<span id="music-btn-text">Enviar Sugestão</span>
						<svg id="music-loading-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
							<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
							<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
						</svg>
					</button>
				</div>

				<!-- Message -->
				<div id="music-message" class="hidden rounded-xl p-4 text-center text-sm"></div>
			</form>
		</div>
	</div>
</section>

<style>
	.music-label {
		@apply block text-xs uppercase tracking-[0.15em] text-olive-500 font-medium mb-2;
	}

	.music-input {
		@apply w-full px-4 py-3 border border-beige-300 rounded-xl text-gray-900 bg-white text-sm transition-all duration-200;
	}

	.music-input:focus {
		@apply outline-none border-olive-400 ring-3 ring-olive-100;
	}

	.music-input::placeholder {
		@apply text-gray-300;
	}

	#music-message.success {
		@apply bg-olive-50 text-olive-700 border border-olive-200;
	}

	#music-message.error {
		@apply bg-red-50 text-red-700 border border-red-200;
	}
</style>

<script>
	const form = document.getElementById('music-form') as HTMLFormElement;
	const message = document.getElementById('music-message') as HTMLDivElement;
	const submitBtn = document.getElementById('music-submit-btn') as HTMLButtonElement;
	const btnText = document.getElementById('music-btn-text') as HTMLSpanElement;
	const loadingSpinner = document.getElementById('music-loading-spinner') as SVGElement;

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();

		// Hide previous messages
		message.classList.add('hidden');
		message.classList.remove('success', 'error');

		// Disable button and show loading
		submitBtn.disabled = true;
		btnText.textContent = 'A enviar...';
		loadingSpinner.classList.remove('hidden');

		const formData = new FormData(form);
		const guestName = (formData.get('guest_name') as string || '').trim();
		const songArtist = (formData.get('song_artist') as string || '').trim();

		try {
			const { createClient } = await import('@supabase/supabase-js');
			const supabaseUrl = (import.meta as any).env.PUBLIC_SUPABASE_URL;
			const supabaseKey = (import.meta as any).env.PUBLIC_SUPABASE_ANON_KEY;
			const supabase = createClient(supabaseUrl, supabaseKey);

			const { error } = await supabase
				.from('music_requests')
				.insert({
					guest_name: guestName,
					song_artist: songArtist,
				});

			if (error) throw new Error(error.message);

			// Success — reset form and show confirmation
			form.reset();
			message.classList.remove('hidden');
			message.classList.add('success');
			message.textContent = '🎶 Obrigado! A tua sugestão foi enviada com sucesso. Vemo-nos na pista!';
		} catch (err) {
			console.error('Music request error:', err);
			// Error — preserve form data and show error
			message.classList.remove('hidden');
			message.classList.add('error');
			message.textContent = 'Ocorreu um erro. Tenta novamente.';
		} finally {
			// Re-enable button and hide loading
			submitBtn.disabled = false;
			btnText.textContent = 'Enviar Sugestão';
			loadingSpinner.classList.add('hidden');
		}
	});
</script>
