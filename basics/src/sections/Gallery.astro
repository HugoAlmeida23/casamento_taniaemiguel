---
// Photo gallery with lightbox — olive/beige palette
// Show 6 preview photos + "Ver todas" button to open full gallery lightbox
//
// Images live in src/assets/memorias and are optimized at build time by Astro:
//  - grid thumbnails: small WebP (~600px)
//  - lightbox: larger WebP (~1600px)
// This turns multi-MB originals into tens of KB, fixing slow/broken loads on mobile.
import { Image, getImage } from 'astro:assets';

// Eagerly import every image in the folder as processed ImageMetadata.
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/memorias/*.{jpg,JPG,jpeg,JPEG,png,PNG}',
	{ eager: true }
);

// Preserve the original display order (Memória 1..38) by filename.
const orderedFilenames = [
	'18.JPG',
	'2021_10.jpg',
	'2022_02.jpg',
	'2023_05_3.jpg',
	'26.jpg',
	'33.jpg',
	'36.jpg',
	'39.jpg',
	'IMG_20201011_130444.jpg',
	'IMG_20210918_151723.jpg',
	'IMG_20231006_162301.jpg',
	'IMG_20260628_165114.jpg',
	'IMG-20210705-WA0021.jpg',
	'IMG-20230530-WA0029.jpg',
	'IMG-20230619-WA00082.jpg',
	'IMG-20240606-WA0064.jpg',
	'IMG-20240903-WA0010.jpg',
	'IMG-20240905-WA0001.jpg',
	'IMG-20241013-WA0006.jpg',
	'IMG-20241013-WA0014.jpg',
	'IMG-20241110-WA0001.jpg',
	'IMG-20241112-WA0012.jpg',
	'IMG-20241112-WA0013.jpg',
	'IMG-20241112-WA0014.jpg',
	'IMG-20241112-WA0016.jpg',
	'IMG-20241112-WA0017.jpg',
	'IMG-20241112-WA0018.jpg',
	'IMG-20241117-WA0004.jpg',
	'IMG-20241229-WA0130.jpg',
	'IMG-20250818-WA0050.jpg',
	'IMG-20250921-WA0020.jpg',
	'IMG20251225152036.jpg',
	'IMG20260314134006.jpg',
	'IMG20260317152708.jpg',
	'IMG20260627182931.jpg',
	'received_313562693332709.jpeg',
	'received_568906853777986.jpeg',
	'received_669196577003162.jpeg',
];

function moduleFor(filename: string) {
	const key = `../assets/memorias/${filename}`;
	const mod = imageModules[key];
	if (!mod) throw new Error(`Gallery image not found: ${filename}`);
	return mod.default;
}

const images = orderedFilenames.map((filename, i) => ({
	image: moduleFor(filename),
	alt: `Memória ${i + 1}`,
}));

const previewImages = images.slice(0, 6);
const remainingCount = images.length - 6;

// Pre-generate optimized full-size WebP URLs for the lightbox (used by JS).
const lightboxUrls = await Promise.all(
	images.map(async ({ image }) => {
		const optimized = await getImage({ src: image, width: 1600, format: 'webp' });
		return optimized.src;
	})
);
---

<section id="gallery" class="wedding-section" style="background-image: url('/casamento_taniaemiguel/images/sand-texture.jpg'); background-size: cover; background-position: center;">
	<div class="max-w-5xl mx-auto">
		<div class="section-header">
			<p class="section-subtitle">Galeria</p>
			<h2 class="section-title">Memórias</h2>
			<div class="ornament">
				<img src={`${import.meta.env.BASE_URL}/images/TM_LOGO.png`} alt="Logo" class="h-10 w-auto" />
			</div>
		</div>

		<!-- Preview grid: 6 photos, last one has overlay -->
		<div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
			{previewImages.map((img, i) => (
				<div 
					class="gallery-item group relative rounded-xl overflow-hidden cursor-pointer shadow-sm hover:shadow-md transition-shadow duration-300"
					data-index={i}
				>
					<div class="aspect-[4/3]">
						<Image
							src={img.image}
							alt={img.alt}
							width={600}
							height={450}
							format="webp"
							quality={72}
							class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
							loading={i < 3 ? 'eager' : 'lazy'}
						/>
					</div>
					{i === 5 && (
						<div class="absolute inset-0 bg-black/40 flex flex-col items-center justify-center transition-colors duration-300 group-hover:bg-black/55">
							<span class="text-white text-2xl md:text-3xl">📸</span>
							<span class="text-white text-sm md:text-base font-light mt-1">Ver mais</span>
						</div>
					)}
					{i !== 5 && (
						<div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
					)}
				</div>
			))}
		</div>

		<!-- "Ver todas" button -->
		<div class="text-center mt-8">
			<button 
				id="open-gallery-btn"
				class="inline-flex items-center gap-2 px-6 py-3 bg-olive-600 text-white rounded-full hover:bg-olive-700 transition-colors duration-300 shadow-md hover:shadow-lg"
				style="background-color: #6b7c4e;"
			>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
				</svg>
				Ver todas as fotos
			</button>
		</div>
	</div>
</section>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 bg-black/95 hidden z-[100] items-center justify-center" role="dialog" aria-modal="true" aria-label="Visualizar foto">
	<!-- Counter -->
	<div id="lightbox-counter" class="absolute top-6 left-6 text-white/70 text-sm font-medium"></div>
	<!-- Close -->
	<button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white transition-colors z-10" aria-label="Fechar">
		<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
		</svg>
	</button>
	<!-- Prev -->
	<button id="lightbox-prev" class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors z-10 bg-black/30 rounded-full p-2" aria-label="Anterior">
		<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path>
		</svg>
	</button>
	<!-- Next -->
	<button id="lightbox-next" class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors z-10 bg-black/30 rounded-full p-2" aria-label="Próxima">
		<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
		</svg>
	</button>
	<!-- Image -->
	<img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[85vh] object-contain rounded-lg" />
</div>

<!-- Hidden data for JS -->
<div id="gallery-data" class="hidden" data-images={JSON.stringify(lightboxUrls)}></div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const lightbox = document.getElementById('lightbox');
		const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
		const lightboxCounter = document.getElementById('lightbox-counter');
		const closeBtn = document.getElementById('lightbox-close');
		const prevBtn = document.getElementById('lightbox-prev');
		const nextBtn = document.getElementById('lightbox-next');
		const openBtn = document.getElementById('open-gallery-btn');
		const galleryData = document.getElementById('gallery-data');
		const items = document.querySelectorAll('.gallery-item');

		// All image URLs from hidden data
		const allImages: string[] = JSON.parse(galleryData?.dataset.images || '[]');
		let currentIndex = 0;

		function updateCounter() {
			if (lightboxCounter) {
				lightboxCounter.textContent = `${currentIndex + 1} / ${allImages.length}`;
			}
		}

		function openLightbox(index: number) {
			currentIndex = index;
			if (lightboxImg) lightboxImg.src = allImages[currentIndex];
			updateCounter();
			lightbox?.classList.remove('hidden');
			lightbox?.classList.add('flex');
			document.body.style.overflow = 'hidden';
		}

		function closeLightbox() {
			lightbox?.classList.add('hidden');
			lightbox?.classList.remove('flex');
			document.body.style.overflow = '';
		}

		function navigate(dir: number) {
			currentIndex = (currentIndex + dir + allImages.length) % allImages.length;
			if (lightboxImg) lightboxImg.src = allImages[currentIndex];
			updateCounter();
		}

		// Click on preview photos opens lightbox at that index
		items.forEach((item) => {
			const index = parseInt((item as HTMLElement).dataset.index || '0');
			item.addEventListener('click', () => openLightbox(index));
		});

		// "Ver todas" button opens lightbox at photo 0
		openBtn?.addEventListener('click', () => openLightbox(0));

		closeBtn?.addEventListener('click', closeLightbox);
		prevBtn?.addEventListener('click', () => navigate(-1));
		nextBtn?.addEventListener('click', () => navigate(1));
		lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
		
		document.addEventListener('keydown', (e) => {
			if (lightbox?.classList.contains('hidden')) return;
			if (e.key === 'Escape') closeLightbox();
			if (e.key === 'ArrowLeft') navigate(-1);
			if (e.key === 'ArrowRight') navigate(1);
		});
	});
</script>
