---
// Programa do dia — elegant timeline with sage/olive background
const events = [
	{ title: 'Cerimónia Religiosa', desc: 'O momento mais especial do dia' },
	{ title: 'Cocktail & Jantar', desc: 'Hora de brindar e saborear o momento' },
	{ title: 'Primeira Dança', desc: 'A abertura oficial da pista' },
	{ title: 'Corte de Bolo', desc: 'Para celebrar o amor' },
	{ title: 'Festa', desc: 'Dançar pela noite dentro!' },
];
---

<section class="wedding-section" style="background-color: #e4e2d4;">
	<div class="max-w-3xl mx-auto">
		<div class="section-header">
			<!-- Couple dancing illustration -->
			<div class="mb-6">
				<img 
					src={`${import.meta.env.BASE_URL}/images/couple-dancing.png`}
					alt="Casal a dançar" 
					class="w-32 md:w-40 h-auto mx-auto opacity-70"
					loading="lazy"
				/>
			</div>
			<p class="section-subtitle">Programa do dia</p>
			<h2 class="section-title">O que planeámos para vocês</h2>
			<div class="ornament">
				<span class="text-lg">🌿</span>
			</div>
		</div>

		<!-- Timeline -->
		<div class="relative">
			<!-- Vertical line -->
			<div class="absolute left-[18px] md:left-1/2 top-0 bottom-0 w-px -translate-x-1/2" style="background-color: #b8b5a4;"></div>

			<div class="space-y-10">
				{events.map((event, i) => (
					<div class={`relative flex items-start gap-6 ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
						{/* Dot */}
						<div class="absolute left-[18px] md:left-1/2 -translate-x-1/2 z-10">
							<div class="w-3 h-3 rounded-full border-2 border-white shadow-sm" style="background-color: #8a8670;"></div>
						</div>

						{/* Content */}
						<div class={`ml-10 md:ml-0 md:w-[calc(50%-2rem)] ${i % 2 === 0 ? 'md:pr-8 md:text-right' : 'md:pl-8 md:text-left'}`}>
							<h3 class="text-lg font-medium mt-1" style="font-family: 'Playfair Display', serif; color: #3d3b2f;">
								{event.title}
							</h3>
							<p class="text-sm mt-1" style="color: #6b6955;">{event.desc}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>
