---
// Mimos e Ofertas section
---

<section class="wedding-section bg-white">
	<div class="max-w-3xl mx-auto">
		<div class="section-header">
			<p class="section-subtitle">Um gesto carinhoso</p>
			<h2 class="section-title">Mimos e Ofertas</h2>
			<div class="ornament">
				<span class="text-lg">🌿</span>
			</div>
		</div>

		<div class="text-center mb-10">
			<p class="text-gray-600 leading-relaxed max-w-xl mx-auto">
				A tua presença é o maior presente de todos. Se quiseres contribuir podes fazê-lo pessoalmente no dia ou através das seguintes formas:
			</p>
		</div>

		<!-- Payment options -->
		<div class="grid sm:grid-cols-2 gap-4 max-w-xl mx-auto">
			<!-- MBWAY -->
			<div class="wedding-card text-center">
				<div class="flex justify-center mb-3">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-olive-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
					</svg>
				</div>
				<h4 class="text-sm uppercase tracking-[0.15em] text-olive-500 font-medium mb-4">MbWay</h4>
				<div class="space-y-3">
					<div>
						<p class="text-xs text-gray-400">Tânia</p>
						<p class="font-mono text-gray-900 font-medium">915 013 015</p>
					</div>
					<div>
						<p class="text-xs text-gray-400">Miguel</p>
						<p class="font-mono text-gray-900 font-medium">917 863 313</p>
					</div>
				</div>
			</div>

			<!-- Bank Transfer -->
			<div class="wedding-card text-center">
				<div class="flex justify-center mb-3">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-olive-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" />
					</svg>
				</div>
				<h4 class="text-sm uppercase tracking-[0.15em] text-olive-500 font-medium mb-4">Transferência</h4>
				<div>
					<p class="text-xs text-gray-400 mb-2">IBAN</p>
					<p class="font-mono text-sm text-gray-900 font-medium break-all">
						PT50 0193 0000 1020 1538 4761 4
					</p>
				</div>
			</div>
		</div>
	</div>
</section>
