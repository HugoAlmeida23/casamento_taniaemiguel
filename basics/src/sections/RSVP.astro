---
// RSVP section — companions added via "+ Adulto" / "+ Criança" buttons
---

<section id="rsvp" class="wedding-section bg-white">
	<div class="max-w-2xl mx-auto">
		<div class="section-header">
			<p class="section-subtitle">Confirmações</p>
			<h2 class="section-title">Esperamos por vocês</h2>
			<div class="ornament">
				<img src={`${import.meta.env.BASE_URL}/images/TM_LOGO.png`} alt="Logo" class="h-10 w-auto" />
			</div>
		</div>

		<div class="wedding-card" style="background-image: url('/casamento_taniaemiguel/images/sand-texture.jpg'); background-size: cover; background-position: center;">
			<form id="rsvp-form" class="space-y-5" autocomplete="on">
				<!-- Nome -->
				<div>
					<label for="nome" class="rsvp-label">Nome *</label>
					<input type="text" id="nome" name="nome" required maxlength="100" class="rsvp-input" placeholder="Primeiro e último nome" />
				</div>

				<!-- Telemóvel -->
				<div>
					<label for="telefone" class="rsvp-label">Telemóvel *</label>
					<input type="tel" id="telefone" name="telefone" required class="rsvp-input" placeholder="+351 912 345 678" />
				</div>

				<!-- Alergias/Restrições alimentares -->
				<div>
					<label for="restricoes" class="rsvp-label">Alergias/Restrições alimentares</label>
					<input type="text" id="restricoes" name="restricoes" class="rsvp-input" placeholder="Glúten, lactose, vegetariano, vegan, …" />
				</div>

				<!-- Acompanhantes section -->
				<div>
					<label class="rsvp-label">Acompanhantes</label>
					<p class="text-xs text-gray-400 mb-2">Adiciona as pessoas que vêm contigo e indica alergias caso tenham.</p>
					<p id="companions-count" class="text-xs text-gray-400 mb-3 hidden"></p>
					
					<!-- List of companions -->
					<div id="companions-list" class="space-y-3 mb-4"></div>

					<!-- Add buttons -->
					<div id="add-buttons-container" class="flex gap-3">
						<button 
							type="button" 
							id="add-adult-btn"
							class="add-companion-btn"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
							</svg>
							Adulto
						</button>
						<button 
							type="button" 
							id="add-child-btn"
							class="add-companion-btn"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
							</svg>
							Criança
						</button>
					</div>
				</div>

				<!-- Mensagem -->
				<div>
					<label for="mensagem" class="rsvp-label">Mensagem para os noivos (opcional)</label>
					<textarea id="mensagem" name="mensagem" rows="2" class="rsvp-input resize-none" placeholder="Uma palavrinha para nós..."></textarea>
				</div>

				<!-- Submit -->
				<div class="pt-3">
					<button 
						type="submit" 
						id="submit-btn"
						class="w-full py-4 px-6 bg-olive-600 hover:bg-olive-700 text-white text-sm font-medium uppercase tracking-[0.15em] rounded-full transition-all duration-300 hover:shadow-lg"
					>
						Enviar Confirmação
					</button>
				</div>

				<!-- Message -->
				<div id="rsvp-message" class="hidden rounded-xl p-4 text-center text-sm"></div>
			</form>
		</div>
	</div>
</section>

<style>
	.rsvp-label {
		@apply block text-xs uppercase tracking-[0.15em] text-olive-500 font-medium mb-2;
	}

	.rsvp-input {
		@apply w-full px-4 py-3 border border-beige-300 rounded-xl text-gray-900 bg-white text-sm transition-all duration-200;
	}

	.rsvp-input:focus {
		@apply outline-none border-olive-400 ring-3 ring-olive-100;
	}

	.rsvp-input::placeholder {
		@apply text-gray-300;
	}

	.add-companion-btn {
		@apply inline-flex items-center gap-2 px-4 py-2.5 border-2 border-dashed border-beige-300 rounded-xl text-sm font-medium text-olive-600 transition-all duration-200;
	}

	.add-companion-btn:hover {
		@apply border-olive-400 bg-olive-50;
	}

	.companion-card {
		@apply relative p-4 border border-beige-200 rounded-xl bg-white/60 space-y-2;
		animation: slideIn 0.3s ease;
	}

	@keyframes slideIn {
		from { opacity: 0; transform: translateY(-8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes fadeOut {
		from { opacity: 1; transform: translateY(0); }
		to { opacity: 0; transform: translateY(-8px); }
	}

	.companion-card.removing {
		animation: fadeOut 0.3s ease forwards;
	}

	.companion-remove {
		@apply absolute top-3 right-3 w-6 h-6 flex items-center justify-center rounded-full text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors;
	}

	.companion-badge {
		@apply inline-block text-[0.6rem] uppercase tracking-wider font-semibold px-2 py-0.5 rounded-full;
	}

	.companion-badge.adult {
		@apply bg-olive-100 text-olive-700;
	}

	.companion-badge.child {
		@apply bg-beige-200 text-beige-800;
	}

	#rsvp-message.success {
		@apply bg-olive-50 text-olive-700 border border-olive-200;
	}

	#rsvp-message.error {
		@apply bg-red-50 text-red-700 border border-red-200;
	}
</style>

<script>
	const MAX_COMPANIONS = 10;

	const form = document.getElementById('rsvp-form') as HTMLFormElement;
	const message = document.getElementById('rsvp-message') as HTMLDivElement;
	const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
	const companionsList = document.getElementById('companions-list') as HTMLDivElement;
	const addAdultBtn = document.getElementById('add-adult-btn') as HTMLButtonElement;
	const addChildBtn = document.getElementById('add-child-btn') as HTMLButtonElement;
	const addButtonsContainer = document.getElementById('add-buttons-container') as HTMLDivElement;
	const companionsCount = document.getElementById('companions-count') as HTMLParagraphElement;

	let companionIdCounter = 0;

	function getCompanionCount(): number {
		return companionsList.querySelectorAll('.companion-card').length;
	}

	function updateCompanionUI() {
		const count = getCompanionCount();
		
		// Show/hide counter
		if (count > 0) {
			companionsCount.classList.remove('hidden');
			companionsCount.textContent = `${count} de ${MAX_COMPANIONS} acompanhantes`;
		} else {
			companionsCount.classList.add('hidden');
		}

		// Disable/enable add buttons when at max
		if (count >= MAX_COMPANIONS) {
			addAdultBtn.disabled = true;
			addChildBtn.disabled = true;
			addAdultBtn.classList.add('opacity-50', 'cursor-not-allowed');
			addChildBtn.classList.add('opacity-50', 'cursor-not-allowed');
		} else {
			addAdultBtn.disabled = false;
			addChildBtn.disabled = false;
			addAdultBtn.classList.remove('opacity-50', 'cursor-not-allowed');
			addChildBtn.classList.remove('opacity-50', 'cursor-not-allowed');
		}
	}

	function addCompanion(type: 'adult' | 'child') {
		if (getCompanionCount() >= MAX_COMPANIONS) return;

		companionIdCounter++;
		const id = companionIdCounter;

		const card = document.createElement('div');
		card.className = 'companion-card';
		card.dataset.companionId = id.toString();
		card.dataset.type = type;

		const badgeClass = type === 'adult' ? 'adult' : 'child';
		const badgeText = type === 'adult' ? 'Adulto' : 'Criança';

		const ageField = type === 'child' 
			? `<input 
				type="number" 
				name="companion_age_${id}" 
				placeholder="Idade" 
				min="0" 
				max="17" 
				step="1"
				class="w-20 px-3 py-3 border border-beige-300 rounded-xl text-gray-900 bg-white text-sm transition-all duration-200 focus:outline-none focus:border-olive-400 focus:ring-3 focus:ring-olive-100"
			/>`
			: '';

		const nameRowClass = type === 'child' ? 'flex gap-2 items-start' : '';

		card.innerHTML = `
			<button type="button" class="companion-remove" aria-label="Remover acompanhante" data-remove="${id}">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
			<span class="companion-badge ${badgeClass}">${badgeText}</span>
			<div class="${nameRowClass}">
				<input 
					type="text" 
					name="companion_name_${id}" 
					placeholder="Primeiro e último nome" 
					class="flex-1 w-full px-4 py-3 border border-beige-300 rounded-xl text-gray-900 bg-white text-sm transition-all duration-200 focus:outline-none focus:border-olive-400 focus:ring-3 focus:ring-olive-100"
				/>
				${ageField}
			</div>
			<input 
				type="text" 
				name="companion_allergy_${id}" 
				maxlength="200"
				placeholder="Alergias / restrições alimentares (opcional)" 
				class="w-full px-4 py-3 border border-beige-300 rounded-xl text-gray-900 bg-white text-sm transition-all duration-200 focus:outline-none focus:border-olive-400 focus:ring-3 focus:ring-olive-100"
			/>
		`;

		companionsList.appendChild(card);

		// Attach remove handler
		const removeBtn = card.querySelector(`[data-remove="${id}"]`);
		removeBtn?.addEventListener('click', () => {
			card.classList.add('removing');
			setTimeout(() => {
				card.remove();
				updateCompanionUI();
			}, 300);
		});

		updateCompanionUI();
	}

	addAdultBtn?.addEventListener('click', () => addCompanion('adult'));
	addChildBtn?.addEventListener('click', () => addCompanion('child'));

	// Form submit
	form?.addEventListener('submit', async (e) => {
		e.preventDefault();

		message.classList.add('hidden');
		message.classList.remove('success', 'error');

		submitBtn.disabled = true;
		const originalText = submitBtn.textContent;
		submitBtn.textContent = 'A enviar...';

		const formData = new FormData(form);

		// Collect companions — filter out those with empty names
		const companions: {name: string, type: string, age?: number, allergy: string}[] = [];
		const cards = companionsList.querySelectorAll('.companion-card');
		cards.forEach(card => {
			const cardEl = card as HTMLElement;
			const id = cardEl.dataset.companionId;
			const type = cardEl.dataset.type || 'adult';
			const name = (formData.get(`companion_name_${id}`) as string || '').trim();
			const allergy = (formData.get(`companion_allergy_${id}`) as string || '').trim();

			if (name) {
				const companion: {name: string, type: string, age?: number, allergy: string} = { 
					name, 
					type, 
					allergy
				};

				if (type === 'child') {
					const ageValue = formData.get(`companion_age_${id}`) as string;
					if (ageValue !== null && ageValue !== '') {
						companion.age = parseInt(ageValue, 10);
					}
				}

				companions.push(companion);
			}
		});

		const payload = {
			nome: formData.get('nome'),
			telefone: formData.get('telefone'),
			attending: true,
			restricoes: formData.get('restricoes') || null,
			companions: companions,
			mensagem: formData.get('mensagem') || null,
		};

		try {
			const { createClient } = await import('@supabase/supabase-js');
			const supabaseUrl = (import.meta as any).env.PUBLIC_SUPABASE_URL;
			const supabaseKey = (import.meta as any).env.PUBLIC_SUPABASE_ANON_KEY;
			const supabase = createClient(supabaseUrl, supabaseKey);

			const { data: insertedGuest, error } = await supabase
				.from('guests')
				.insert({
					nome: payload.nome,
					telefone: payload.telefone,
					acompanha: payload.companions.length > 0 ? 1 : 0,
					restricoes: payload.restricoes || null,
					companions: payload.companions,
					mensagem: payload.mensagem || null,
				})
				.select('id')
				.single();

			if (error) throw new Error(error.message);

			// Normalized model: create one `attendees` row per physical person
			// (main contact + each companion). Non-fatal if it fails, so a guest
			// is never blocked from confirming — the admin backfill SQL can repair.
			if (insertedGuest?.id) {
				const attendeeRows = [
					{
						guest_id: insertedGuest.id,
						name: payload.nome,
						type: 'adult',
						is_primary: true,
						allergy: payload.restricoes || null,
					},
					...payload.companions.map((c) => ({
						guest_id: insertedGuest.id,
						name: c.name,
						type: c.type || 'adult',
						is_primary: false,
						allergy: c.allergy || null,
					})),
				];
				const { error: attErr } = await supabase.from('attendees').insert(attendeeRows);
				if (attErr) console.warn('attendees insert failed (non-fatal):', attErr.message);
			}

			form.reset();
			companionsList.innerHTML = '';
			companionIdCounter = 0;
			updateCompanionUI();

			message.classList.remove('hidden');
			message.classList.add('success');
			message.textContent = '🌿 Obrigado! Recebemos a vossa confirmação. Mal podemos esperar!';
		} catch (err) {
			console.error(err);
			message.classList.remove('hidden');
			message.classList.add('error');
			message.textContent = 'Ocorreu um erro. Tentem novamente ou contactem-nos diretamente.';
		} finally {
			submitBtn.disabled = false;
			submitBtn.textContent = originalText;
		}
	});
</script>
