---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Galeria de Fotos — Tânia & Miguel">
  <main id="fotos-main">
    <!-- HEADER -->
    <header class="fotos-header">
      <a href={`/`} class="back-link" aria-label="Voltar à página principal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
      <p class="fotos-subtitle">Casamento Tânia &amp; Miguel</p>
      <h1 class="fotos-title">Galeria ao Vivo</h1>
      <div class="fotos-ornament"><span>✦</span></div>
      <p class="fotos-tagline">Partilha as tuas fotos e vê as de todos, em tempo real.</p>
    </header>

    <!-- GUEST NAME (optional, inline chip) -->
    <section class="guest-name-section">
      <button id="name-chip" type="button" class="name-chip" aria-label="Definir o seu nome">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span id="name-chip-text">Adicionar o meu nome</span>
      </button>
    </section>

    <!-- PHOTO GRID -->
    <section id="photo-grid-section" class="photo-grid-section">
      <div id="photo-grid" class="photo-grid"></div>

      <div id="empty-state" class="empty-state">
        <div class="empty-icon">📸</div>
        <p class="empty-title">Ainda não há fotos</p>
        <p class="empty-sub">Sê o primeiro a partilhar um momento!</p>
      </div>

      <div id="grid-loading" class="grid-loading hidden">
        <div class="loading-spinner"></div>
        <span>A carregar...</span>
      </div>
      <div id="scroll-sentinel" class="scroll-sentinel"></div>
    </section>

    <!-- FAB -->
    <button id="fab-upload" class="fab-upload" aria-label="Partilhar fotos">
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M5 12h14" />
      </svg>
      <span class="fab-label">Partilhar</span>
    </button>

    <!-- UPLOAD BOTTOM SHEET -->
    <div id="sheet" class="sheet hidden" role="dialog" aria-modal="true" aria-label="Partilhar fotos">
      <div class="sheet-backdrop" data-close-sheet></div>
      <div class="sheet-panel">
        <div class="sheet-handle"></div>
        <h2 class="sheet-title">Partilhar fotos</h2>
        <p class="sheet-sub">Podes escolher várias de uma vez.</p>

        <button id="btn-camera" type="button" class="sheet-option">
          <span class="sheet-option-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          </span>
          <span class="sheet-option-text">
            <span class="sheet-option-title">Tirar foto</span>
            <span class="sheet-option-desc">Abrir a câmara</span>
          </span>
        </button>

        <button id="btn-library" type="button" class="sheet-option sheet-option-primary">
          <span class="sheet-option-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          </span>
          <span class="sheet-option-text">
            <span class="sheet-option-title">Escolher da galeria</span>
            <span class="sheet-option-desc">Selecionar uma ou mais fotos</span>
          </span>
        </button>

        <button type="button" class="sheet-cancel" data-close-sheet>Cancelar</button>
      </div>
    </div>

    <!-- Hidden inputs -->
    <input id="input-camera" type="file" accept="image/*" capture="environment" class="visually-hidden" />
    <input id="input-library" type="file" accept="image/jpeg,image/png,image/heic,image/heif,image/webp" multiple class="visually-hidden" />

    <!-- UPLOAD TRAY -->
    <div id="upload-tray" class="upload-tray hidden" aria-live="polite">
      <div class="tray-header">
        <span id="tray-title" class="tray-title">A enviar...</span>
        <button id="tray-close" type="button" class="tray-close hidden" aria-label="Fechar">✕</button>
      </div>
      <div id="tray-items" class="tray-items"></div>
    </div>

    <!-- LIGHTBOX -->
    <div id="lightbox" class="lightbox hidden" role="dialog" aria-modal="true" aria-label="Visualizar foto">
      <div class="lightbox-backdrop"></div>
      <button id="lightbox-close" class="lightbox-close" aria-label="Fechar">✕</button>
      <button id="lightbox-prev" class="lightbox-nav lightbox-prev-btn" aria-label="Foto anterior">‹</button>
      <button id="lightbox-next" class="lightbox-nav lightbox-next-btn" aria-label="Próxima foto">›</button>
      <div id="lightbox-img-container" class="lightbox-img-container">
        <div class="lightbox-spinner"></div>
        <img id="lightbox-img" src="" alt="Foto em ecrã inteiro" />
      </div>
      <div id="lightbox-caption" class="lightbox-caption"></div>
    </div>

    <!-- NAME MODAL -->
    <div id="name-modal" class="name-modal hidden" role="dialog" aria-modal="true" aria-label="O seu nome">
      <div class="name-modal-backdrop" data-close-name></div>
      <div class="name-modal-panel">
        <h2 class="name-modal-title">Como te chamas?</h2>
        <p class="name-modal-sub">O teu nome aparece junto às tuas fotos. Podes deixar em branco.</p>
        <input id="name-input" type="text" placeholder="O teu nome..." autocomplete="name" class="name-modal-input" />
        <div class="name-modal-actions">
          <button type="button" class="name-modal-skip" data-close-name>Agora não</button>
          <button id="name-save" type="button" class="name-modal-save">Guardar</button>
        </div>
      </div>
    </div>

    <!-- RECONNECTING -->
    <div id="reconnecting-indicator" class="reconnecting-indicator hidden">
      <span>A reconectar...</span>
    </div>

    <!-- TOAST -->
    <div id="toast" class="toast hidden" role="status" aria-live="polite"></div>
  </main>
</Layout>

<script>
  import { supabase } from '../scripts/supabase';
  import {
    validateFile,
    generateFilename,
    compressImage,
    getThumbnailUrl,
    getThumbnailPath,
    getFullResUrl,
    formatRelativeTime,
    setGuestName,
    getGuestName,
    type PhotoRecord,
  } from '../scripts/photo-gallery-utils';

  // === State ===
  let photos: PhotoRecord[] = [];
  let currentOffset = 0;
  const PAGE_SIZE = 24;
  let isLoadingMore = false;
  let hasMore = true;
  let lightboxIndex = -1;
  let uploadCounter = 0;
  let activeUploads = 0;

  // === DOM ===
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const photoGrid = $('photo-grid');
  const emptyState = $('empty-state');
  const gridLoading = $('grid-loading');
  const scrollSentinel = $('scroll-sentinel');
  const fabUpload = $<HTMLButtonElement>('fab-upload');
  const sheet = $('sheet');
  const btnCamera = $('btn-camera');
  const btnLibrary = $('btn-library');
  const inputCamera = $<HTMLInputElement>('input-camera');
  const inputLibrary = $<HTMLInputElement>('input-library');
  const uploadTray = $('upload-tray');
  const trayItems = $('tray-items');
  const trayTitle = $('tray-title');
  const trayClose = $<HTMLButtonElement>('tray-close');
  const lightbox = $('lightbox');
  const lightboxImg = $<HTMLImageElement>('lightbox-img');
  const lightboxCaption = $('lightbox-caption');
  const lightboxImgContainer = $('lightbox-img-container');
  const reconnectingIndicator = $('reconnecting-indicator');
  const nameChip = $('name-chip');
  const nameChipText = $('name-chip-text');
  const nameModal = $('name-modal');
  const nameInput = $<HTMLInputElement>('name-input');
  const nameSave = $('name-save');
  const toast = $('toast');

  // === Toast ===
  let toastTimer: ReturnType<typeof setTimeout> | undefined;
  function showToast(msg: string) {
    toast.textContent = msg;
    toast.classList.remove('hidden');
    requestAnimationFrame(() => toast.classList.add('toast-visible'));
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.remove('toast-visible');
      setTimeout(() => toast.classList.add('hidden'), 300);
    }, 3000);
  }

  // === Guest name ===
  function refreshNameChip() {
    const name = getGuestName();
    if (name) {
      nameChipText.textContent = name;
      nameChip.classList.add('name-chip-set');
    } else {
      nameChipText.textContent = 'Adicionar o meu nome';
      nameChip.classList.remove('name-chip-set');
    }
  }
  function openNameModal() {
    nameInput.value = getGuestName() || '';
    nameModal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    setTimeout(() => nameInput.focus(), 50);
  }
  function closeNameModal() {
    nameModal.classList.add('hidden');
    document.body.style.overflow = '';
  }
  nameChip.addEventListener('click', openNameModal);
  nameSave.addEventListener('click', () => {
    setGuestName(nameInput.value.trim());
    refreshNameChip();
    closeNameModal();
  });
  nameInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') nameSave.click(); });
  nameModal.querySelectorAll('[data-close-name]').forEach((el) =>
    el.addEventListener('click', closeNameModal)
  );

  // === Grid rendering ===
  function renderPhotoCard(photo: PhotoRecord): HTMLElement {
    const card = document.createElement('button');
    card.className = 'photo-card';
    card.type = 'button';
    card.dataset.photoId = photo.id;

    const frame = document.createElement('div');
    frame.className = 'photo-card-frame';

    const img = document.createElement('img');
    img.src = getThumbnailUrl(photo.storage_path);
    img.alt = photo.uploader_name ? `Foto de ${photo.uploader_name}` : 'Foto do casamento';
    img.loading = 'lazy';
    img.decoding = 'async';
    img.className = 'photo-card-img';
    // Fallback for legacy photos without a generated thumbnail.
    img.addEventListener('error', () => {
      if (img.dataset.fallback) return;
      img.dataset.fallback = '1';
      img.src = getFullResUrl(photo.storage_path);
    });
    img.addEventListener('load', () => frame.classList.add('loaded'));

    frame.appendChild(img);

    const overlay = document.createElement('div');
    overlay.className = 'photo-card-overlay';
    overlay.innerHTML = `<span class="photo-card-name">${escapeHtml(photo.uploader_name || 'Anónimo')}</span>`;

    card.appendChild(frame);
    card.appendChild(overlay);

    card.addEventListener('click', () => {
      const idx = photos.findIndex((p) => p.id === photo.id);
      if (idx !== -1) openLightbox(idx);
    });
    return card;
  }

  function escapeHtml(s: string): string {
    const div = document.createElement('div');
    div.textContent = s;
    return div.innerHTML;
  }

  function updateEmptyState() {
    emptyState.classList.toggle('hidden', photos.length !== 0);
  }

  // === Loading ===
  async function loadInitialPhotos() {
    gridLoading.classList.remove('hidden');
    try {
      const { data, error } = await supabase
        .from('photos')
        .select('*')
        .eq('is_visible', true)
        .order('created_at', { ascending: false })
        .range(0, PAGE_SIZE - 1);
      if (error) throw error;

      photos = data || [];
      currentOffset = photos.length;
      hasMore = photos.length === PAGE_SIZE;

      photoGrid.innerHTML = '';
      const frag = document.createDocumentFragment();
      photos.forEach((p) => frag.appendChild(renderPhotoCard(p)));
      photoGrid.appendChild(frag);
      updateEmptyState();
    } catch (err) {
      console.error('Failed to load photos:', err);
      showToast('Não foi possível carregar as fotos.');
    } finally {
      gridLoading.classList.add('hidden');
    }
  }

  async function loadMorePhotos() {
    if (isLoadingMore || !hasMore) return;
    isLoadingMore = true;
    gridLoading.classList.remove('hidden');
    try {
      const { data, error } = await supabase
        .from('photos')
        .select('*')
        .eq('is_visible', true)
        .order('created_at', { ascending: false })
        .range(currentOffset, currentOffset + PAGE_SIZE - 1);
      if (error) throw error;

      const newPhotos = data || [];
      hasMore = newPhotos.length === PAGE_SIZE;
      currentOffset += newPhotos.length;

      const frag = document.createDocumentFragment();
      newPhotos.forEach((p) => {
        photos.push(p);
        frag.appendChild(renderPhotoCard(p));
      });
      photoGrid.appendChild(frag);
    } catch (err) {
      console.error('Failed to load more:', err);
    } finally {
      isLoadingMore = false;
      gridLoading.classList.add('hidden');
    }
  }

  const scrollObserver = new IntersectionObserver(
    (entries) => { if (entries[0].isIntersecting) loadMorePhotos(); },
    { rootMargin: '400px' }
  );
  scrollObserver.observe(scrollSentinel);

  // === Realtime ===
  function subscribeToRealtime() {
    supabase
      .channel('photos-realtime')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'photos' }, (payload) => {
        const p = payload.new as PhotoRecord;
        if (!p.is_visible || photos.find((x) => x.id === p.id)) return;
        photos.unshift(p);
        const card = renderPhotoCard(p);
        card.classList.add('photo-card-new');
        photoGrid.prepend(card);
        updateEmptyState();
      })
      .on('postgres_changes', { event: 'DELETE', schema: 'public', table: 'photos' }, (payload) => {
        const id = (payload.old as { id: string }).id;
        photos = photos.filter((x) => x.id !== id);
        const card = photoGrid.querySelector(`[data-photo-id="${id}"]`);
        if (card) {
          card.classList.add('photo-card-removing');
          setTimeout(() => card.remove(), 300);
        }
        updateEmptyState();
      })
      .subscribe((status) => {
        if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT') {
          reconnectingIndicator.classList.remove('hidden');
        }
        if (status === 'SUBSCRIBED') {
          reconnectingIndicator.classList.add('hidden');
        }
      });
  }

  // === Bottom sheet ===
  function openSheet() {
    sheet.classList.remove('hidden');
    requestAnimationFrame(() => sheet.classList.add('sheet-open'));
    document.body.style.overflow = 'hidden';
  }
  function closeSheet() {
    sheet.classList.remove('sheet-open');
    setTimeout(() => sheet.classList.add('hidden'), 250);
    document.body.style.overflow = '';
  }
  fabUpload.addEventListener('click', openSheet);
  sheet.querySelectorAll('[data-close-sheet]').forEach((el) => el.addEventListener('click', closeSheet));
  btnCamera.addEventListener('click', () => { closeSheet(); inputCamera.click(); });
  btnLibrary.addEventListener('click', () => { closeSheet(); inputLibrary.click(); });

  inputCamera.addEventListener('change', () => handleFiles(inputCamera.files));
  inputLibrary.addEventListener('change', () => handleFiles(inputLibrary.files));

  // === Upload tray ===
  function showTray() {
    uploadTray.classList.remove('hidden');
    requestAnimationFrame(() => uploadTray.classList.add('tray-open'));
  }
  function updateTrayTitle() {
    if (activeUploads > 0) {
      trayTitle.textContent = activeUploads === 1 ? 'A enviar 1 foto...' : `A enviar ${activeUploads} fotos...`;
      trayClose.classList.add('hidden');
    } else {
      trayTitle.textContent = 'Concluído';
      trayClose.classList.remove('hidden');
    }
  }
  trayClose.addEventListener('click', () => {
    uploadTray.classList.remove('tray-open');
    setTimeout(() => { uploadTray.classList.add('hidden'); trayItems.innerHTML = ''; }, 250);
  });

  function addTrayItem(id: string, previewUrl: string): HTMLElement {
    const item = document.createElement('div');
    item.className = 'tray-item';
    item.dataset.uploadId = id;
    item.innerHTML = `
      <div class="tray-thumb"><img src="${previewUrl}" alt="" /></div>
      <div class="tray-status">
        <span class="tray-status-text">Na fila...</span>
        <div class="tray-bar"><div class="tray-bar-fill"></div></div>
      </div>
      <div class="tray-state" aria-hidden="true"></div>
    `;
    trayItems.appendChild(item);
    return item;
  }
  function setTrayStatus(item: HTMLElement, text: string, state?: 'ok' | 'err', progress?: number) {
    const txt = item.querySelector('.tray-status-text') as HTMLElement;
    const fill = item.querySelector('.tray-bar-fill') as HTMLElement;
    const stateEl = item.querySelector('.tray-state') as HTMLElement;
    txt.textContent = text;
    if (typeof progress === 'number') fill.style.width = `${progress}%`;
    if (state === 'ok') { stateEl.textContent = '✓'; stateEl.className = 'tray-state tray-state-ok'; fill.style.width = '100%'; }
    else if (state === 'err') { stateEl.textContent = '!'; stateEl.className = 'tray-state tray-state-err'; }
  }

  // === Upload pipeline ===
  async function handleFiles(fileList: FileList | null) {
    if (!fileList || fileList.length === 0) return;
    const files = Array.from(fileList);
    inputCamera.value = '';
    inputLibrary.value = '';

    showTray();
    // Kick them off with limited concurrency so we don't saturate a phone's uplink.
    const queue = [...files];
    const CONCURRENCY = 2;
    const workers = Array.from({ length: Math.min(CONCURRENCY, queue.length) }, () => worker(queue));
    await Promise.all(workers);
  }

  async function worker(queue: File[]) {
    while (queue.length) {
      const file = queue.shift()!;
      await uploadOne(file);
    }
  }

  async function uploadOne(file: File) {
    const id = `u${++uploadCounter}`;
    const localPreview = URL.createObjectURL(file);
    const item = addTrayItem(id, localPreview);
    activeUploads++;
    updateTrayTitle();

    try {
      const validation = validateFile(file);
      if (!validation.valid) {
        setTrayStatus(item, validation.error || 'Ficheiro inválido', 'err');
        return;
      }

      setTrayStatus(item, 'A preparar...', undefined, 15);
      const fullBlob = await compressImage(file, 1920, 0.85);
      const thumbBlob = await compressImage(fullBlob, 500, 0.7).catch(() => null);

      const filename = generateFilename();
      setTrayStatus(item, 'A enviar...', undefined, 45);

      const { error: upErr } = await supabase.storage
        .from('wedding-photos')
        .upload(filename, fullBlob, { contentType: 'image/jpeg', upsert: false });
      if (upErr) throw upErr;

      // Best-effort thumbnail; gallery falls back to full image if missing.
      if (thumbBlob) {
        setTrayStatus(item, 'A finalizar...', undefined, 80);
        await supabase.storage
          .from('wedding-photos')
          .upload(getThumbnailPath(filename), thumbBlob, { contentType: 'image/jpeg', upsert: false })
          .catch((e) => console.warn('Thumb upload failed (non-fatal):', e));
      }

      const guestName = getGuestName() || 'Anónimo';
      const { error: insErr } = await supabase
        .from('photos')
        .insert({ storage_path: filename, uploader_name: guestName });
      if (insErr) throw insErr;

      setTrayStatus(item, 'Partilhada!', 'ok');
    } catch (err) {
      console.error('Upload failed:', err);
      setTrayStatus(item, 'Falhou. Toca para repetir', 'err');
      item.classList.add('tray-item-retry');
      item.onclick = () => { item.onclick = null; item.remove(); uploadOne(file); };
    } finally {
      URL.revokeObjectURL(localPreview);
      activeUploads--;
      updateTrayTitle();
      if (activeUploads === 0) {
        const anyError = trayItems.querySelector('.tray-state-err');
        if (!anyError) showToast('Fotos partilhadas com sucesso!');
      }
    }
  }

  // === Lightbox ===
  function openLightbox(index: number) {
    if (index < 0 || index >= photos.length) return;
    lightboxIndex = index;
    const photo = photos[index];
    lightboxImgContainer.classList.add('loading');
    lightboxImg.src = getFullResUrl(photo.storage_path);
    lightboxImg.onload = () => lightboxImgContainer.classList.remove('loading');
    lightboxCaption.textContent = photo.uploader_name
      ? `${photo.uploader_name} · ${formatRelativeTime(photo.created_at)}`
      : formatRelativeTime(photo.created_at);
    lightbox.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    preloadAdjacent(index);
  }
  function closeLightbox() {
    lightbox.classList.add('hidden');
    document.body.style.overflow = '';
    lightboxIndex = -1;
  }
  function navigateLightbox(dir: 'prev' | 'next') {
    if (lightboxIndex === -1) return;
    const n = dir === 'prev'
      ? (lightboxIndex - 1 + photos.length) % photos.length
      : (lightboxIndex + 1) % photos.length;
    openLightbox(n);
  }
  function preloadAdjacent(index: number) {
    [index - 1, index + 1].forEach((i) => {
      const idx = (i + photos.length) % photos.length;
      if (photos[idx]) { const im = new Image(); im.src = getFullResUrl(photos[idx].storage_path); }
    });
  }
  $('lightbox-close').addEventListener('click', closeLightbox);
  $('lightbox-prev').addEventListener('click', () => navigateLightbox('prev'));
  $('lightbox-next').addEventListener('click', () => navigateLightbox('next'));
  lightbox.querySelector('.lightbox-backdrop')!.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navigateLightbox('prev');
    if (e.key === 'ArrowRight') navigateLightbox('next');
  });

  // Swipe (lightbox)
  let touchStartX = 0, touchEndX = 0;
  lightboxImgContainer.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
  lightboxImgContainer.addEventListener('touchmove', (e) => { touchEndX = e.changedTouches[0].screenX; }, { passive: true });
  lightboxImgContainer.addEventListener('touchend', () => {
    const diff = touchStartX - touchEndX;
    if (Math.abs(diff) > 50) navigateLightbox(diff > 0 ? 'next' : 'prev');
    touchEndX = touchStartX;
  });

  // Swipe down to close sheet
  let sheetStartY = 0;
  const sheetPanel = sheet.querySelector('.sheet-panel') as HTMLElement;
  sheetPanel.addEventListener('touchstart', (e) => { sheetStartY = e.changedTouches[0].screenY; }, { passive: true });
  sheetPanel.addEventListener('touchend', (e) => {
    if (e.changedTouches[0].screenY - sheetStartY > 80) closeSheet();
  }, { passive: true });

  // === Init ===
  refreshNameChip();
  loadInitialPhotos();
  subscribeToRealtime();
</script>

<style is:global>
  :root {
    --olive: #8f8a5e;
    --olive-dark: #74704a;
    --gold: #e6b040;
    --gold-dark: #d4983a;
    --ink: #2d2b22;
    --muted: #8f8a5e;
    --paper: #fdfcf9;
    --line: #ede6d3;
  }

  #fotos-main {
    min-height: 100vh;
    background: var(--paper);
    position: relative;
    padding-bottom: 6rem;
  }
  .hidden { display: none !important; }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* HEADER */
  .fotos-header { text-align: center; padding: 1.75rem 1.5rem 1rem; position: relative; }
  .back-link {
