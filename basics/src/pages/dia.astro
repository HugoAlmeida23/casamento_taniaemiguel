---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="O Grande Dia — Tânia & Miguel">
	<main class="pt-12 pb-16">
		<!-- Page Header -->
		<div class="wedding-section pb-8">
			<div class="max-w-4xl mx-auto text-center">
				<p class="section-subtitle">28 de Maio de 2027</p>
				<h1 class="section-title text-4xl md:text-5xl lg:text-6xl">O Grande Dia</h1>
				<div class="ornament">
					<img src={`${baseUrl}/images/TM_LOGO.png`} alt="Logo" class="h-10 w-auto" />
				</div>
				<p class="text-gray-600 text-sm md:text-base max-w-xl mx-auto mt-4">
					Tudo o que precisas de saber para aproveitares este dia connosco.
				</p>
			</div>
		</div>

		<!-- Table Seating Section -->
		<section id="mesas" class="wedding-section bg-white">
			<div class="max-w-4xl mx-auto">
				<div class="section-header">
					<p class="section-subtitle">Organização</p>
					<h2 class="section-title">Disposição das Mesas</h2>
					<div class="ornament">
						<img src={`${baseUrl}/images/TM_LOGO.png`} alt="Logo" class="h-10 w-auto" />
					</div>
				</div>

				<div class="wedding-card text-center max-w-2xl mx-auto">
					<div class="text-4xl mb-4">🍽️</div>
					<p class="text-gray-700 mb-6">
						Para tornar o jantar ainda mais especial, organizámos as mesas com todo o carinho.
						Descobre onde vais ficar sentado(a) e quem serão os teus companheiros de mesa!
					</p>
					<a 
						href={`${baseUrl}/mesa`}
						class="inline-flex items-center gap-2 px-6 py-3 bg-olive-500 hover:bg-olive-600 text-white text-sm font-medium rounded-full transition-colors"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
						Encontrar a minha mesa
					</a>
				</div>
			</div>
		</section>

		<!-- Ementa Section -->
		<section id="ementa-section" class="wedding-section" aria-labelledby="ementa-heading">
			<div class="max-w-3xl mx-auto">
				<div class="section-header">
					<p class="section-subtitle">Gastronomia</p>
					<h2 id="ementa-heading" class="section-title">Ementa</h2>
					<div class="ornament">
						<img src={`${baseUrl}/images/TM_LOGO.png`} alt="Logo" class="h-10 w-auto" />
					</div>
					<p class="text-gray-500 text-sm mt-2">Uma seleção cuidada de sabores para celebrar este dia especial</p>
				</div>

				<div class="space-y-8">
					<!-- Entradas -->
					<div class="wedding-card p-6">
						<h3 class="text-lg font-light text-gray-900 mb-4 text-center" style="font-family: 'Playfair Display', serif;">Entradas</h3>
						<ul class="space-y-3 text-sm text-gray-600">
							<li class="flex justify-between items-baseline gap-2">
								<span class="font-medium text-gray-800">Tábua de Queijos e Enchidos da Região</span>
								<span class="border-b border-dotted border-gray-300 flex-1 mx-2"></span>
								<span class="text-gray-500 text-xs italic">Seleção artesanal com mel e frutos secos</span>
							</li>
							<li class="flex justify-between items-baseline gap-2">
								<span class="font-medium text-gray-800">Alheira Frita com Grelos Salteados</span>
								<span class="border-b border-dotted border-gray-300 flex-1 mx-2"></span>
								<span class="text-gray-500 text-xs italic">Receita tradicional portuguesa</span>
							</li>
							<li class="flex justify-between items-baseline gap-2">
								<span class="font-medium text-gray-800">Gambas ao Alho com Coentros</span>
								<span class="border-b border-dotted border-gray-300 flex-1 mx-2"></span>
								<span class="text-gray-500 text-xs italic">Servidas com pão torrado caseiro</span>
							</li>
							<li class="flex justify-between items-baseline gap-2">
								<span class="font-medium text-gray-800">Salada de Polvo Grelhado</span>
								<span class="border-b border-dotted border-gray-300 flex-1 mx-2"></span>
								<span class="text-gray-500 text-xs italic">Com batata, cebola roxa e azeite virgem</span>
							</li>
						</ul>
					</div>

					<!-- Prato Principal -->
					<div class="wedding-card p-6">
						<h3 class="text-lg font-light text-gray-900 mb-4 text-center" style="font-family: 'Playfair Display', serif;">Prato Principal</h3>
						<ul class="space-y-3 text-sm text-gray-600">
							<li class="flex justify-between items-baseline gap-2">
								<span class="font-medium text-gray-800">Lombo de Vitela Assado com Ervas</span>
								<span class="border-b border-dotted border-gray-300 flex-1 mx-2"></span>
								<span class="text-gray-500 text-xs italic">Acompanhado de puré de batata trufado</span>
							</li>
							<li class="flex justify-between items-baseline gap-2">
								<span class="font-medium text-gray-800">Bacalhau com Broa e Espinafres</span>
								<span class="border-b border-dotted border-gray-300 flex-1 mx-2"></span>
								<span class="text-gray-500 text-xs italic">Gratinado no forno com azeite da casa</span>
							</li>
						</ul>
					</div>

					<!-- Sobremesa -->
					<div class="wedding-card p-6">
						<h3 class="text-lg font-light text-gray-900 mb-4 text-center" style="font-family: 'Playfair Display', serif;">Sobremesa</h3>
						<ul class="space-y-3 text-sm text-gray-600">
							<li class="flex justify-between items-baseline gap-2">
								<span class="font-medium text-gray-800">Bolo de Noiva</span>
								<span class="border-b border-dotted border-gray-300 flex-1 mx-2"></span>
								<span class="text-gray-500 text-xs italic">Camadas de baunilha com creme de framboesa</span>
							</li>
							<li class="flex justify-between items-baseline gap-2">
								<span class="font-medium text-gray-800">Leite-Creme Queimado</span>
								<span class="border-b border-dotted border-gray-300 flex-1 mx-2"></span>
								<span class="text-gray-500 text-xs italic">Receita conventual com canela</span>
							</li>
							<li class="flex justify-between items-baseline gap-2">
								<span class="font-medium text-gray-800">Mesa de Doces Regionais</span>
								<span class="border-b border-dotted border-gray-300 flex-1 mx-2"></span>
								<span class="text-gray-500 text-xs italic">Pastéis de nata, travesseiros e queijadas</span>
							</li>
						</ul>
					</div>

					<!-- Bebidas -->
					<div class="wedding-card p-6">
						<h3 class="text-lg font-light text-gray-900 mb-4 text-center" style="font-family: 'Playfair Display', serif;">Bebidas</h3>
						<ul class="space-y-3 text-sm text-gray-600">
							<li class="flex justify-between items-baseline gap-2">
								<span class="font-medium text-gray-800">Espumante de Boas-Vindas</span>
								<span class="border-b border-dotted border-gray-300 flex-1 mx-2"></span>
								<span class="text-gray-500 text-xs italic">Bruto natural da região</span>
							</li>
							<li class="flex justify-between items-baseline gap-2">
								<span class="font-medium text-gray-800">Vinho Branco e Tinto da Quinta</span>
								<span class="border-b border-dotted border-gray-300 flex-1 mx-2"></span>
								<span class="text-gray-500 text-xs italic">Seleção do enólogo para a ocasião</span>
							</li>
							<li class="flex justify-between items-baseline gap-2">
								<span class="font-medium text-gray-800">Águas, Sumos Naturais e Café</span>
								<span class="border-b border-dotted border-gray-300 flex-1 mx-2"></span>
								<span class="text-gray-500 text-xs italic">Disponíveis durante toda a refeição</span>
							</li>
						</ul>
					</div>
				</div>

				<p class="text-center text-xs text-gray-500 mt-6 italic">
					Menu sujeito a pequenas alterações sazonais
				</p>
			</div>
		</section>

		<!-- Live Gallery Section -->
		<section id="galeria-ao-vivo" class="wedding-section bg-white">
			<div class="max-w-4xl mx-auto">
				<div class="section-header">
					<p class="section-subtitle">Partilha</p>
					<h2 class="section-title">Galeria ao Vivo</h2>
					<div class="ornament">
						<img src={`${baseUrl}/images/TM_LOGO.png`} alt="Logo" class="h-10 w-auto" />
					</div>
				</div>

				<div class="wedding-card text-center max-w-2xl mx-auto">
					<div class="text-4xl mb-4">🤳</div>
					<p class="text-gray-700 mb-6">
						Queremos ver este dia pelos vossos olhos! Faz upload das tuas fotos e vídeos em tempo real 
						e vê o que os outros convidados estão a captar. Juntos vamos criar um álbum inesquecível.
					</p>
					<a 
						href={`${baseUrl}/fotos`}
						class="inline-flex items-center gap-2 px-6 py-3 bg-olive-500 hover:bg-olive-600 text-white text-sm font-medium rounded-full transition-colors"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
						</svg>
						Abrir galeria ao vivo
					</a>
				</div>
			</div>
		</section>

		<!-- Solidarity Section -->
		<section id="solidarity-dia" class="wedding-section bg-white">
			<div class="max-w-4xl mx-auto">
				<div class="section-header">
					<h2 class="section-title">Este é um casamento solidário!</h2>
					<div class="ornament">
						<img src={`${baseUrl}/images/TM_LOGO.png`} alt="Logo" class="h-10 w-auto" />
					</div>
				</div>

				<div class="text-center mb-10 space-y-4">
					<p class="text-gray-600 leading-relaxed max-w-2xl mx-auto text-justify">
						O melhor presente que podemos receber é a tua presença, mas o melhor presente que podemos dar é a esperança. Neste dia, escolhemos transformar as tradicionais lembranças de casamento em sorrisos e apoio a quem mais precisa, através de donativos a instituições de solidariedade social.
					</p>
					<p class="text-gray-600 leading-relaxed max-w-2xl mx-auto text-justify">
						Porque a tua presença nos faz felizes, e a tua generosidade pode fazer a diferença na vida de muitos. Se te quiseres juntar a esta causa podes fazê-lo diretamente através dos links abaixo:
					</p>
				</div>

				<div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto">
					<a href="https://narizvermelho.pt/lojinha/" target="_blank" rel="noopener noreferrer" class="wedding-card flex flex-col items-center justify-center gap-3 p-6 hover:shadow-md transition-shadow">
						<img src={`${baseUrl}/images/NARIZVERMELHO.png`} alt="Nariz Vermelho" class="max-h-[48px] w-auto object-contain" loading="lazy" />
						<span class="text-xs text-olive-600 font-medium text-center">Nariz Vermelho</span>
					</a>
					<a href="https://acreditar.org.pt/colaborar/presentes-solidarios/" target="_blank" rel="noopener noreferrer" class="wedding-card flex flex-col items-center justify-center gap-3 p-6 hover:shadow-md transition-shadow">
						<img src={`${baseUrl}/images/ACREDITAR.png`} alt="Acreditar" class="max-h-[48px] w-auto object-contain" loading="lazy" />
						<span class="text-xs text-olive-600 font-medium text-center">Acreditar</span>
					</a>
					<a href="https://makeawish.pt/montra-solidaria/" target="_blank" rel="noopener noreferrer" class="wedding-card flex flex-col items-center justify-center gap-3 p-6 hover:shadow-md transition-shadow">
						<img src={`${baseUrl}/images/MAKEAWISH.png`} alt="Make-A-Wish" class="max-h-[48px] w-auto object-contain" loading="lazy" />
						<span class="text-xs text-olive-600 font-medium text-center">Make-A-Wish</span>
					</a>
					<a href="https://presentesparaavida.unicef.pt/todos-os-produtos/" target="_blank" rel="noopener noreferrer" class="wedding-card flex flex-col items-center justify-center gap-3 p-6 hover:shadow-md transition-shadow">
						<img src={`${baseUrl}/images/UNICEF.png`} alt="UNICEF" class="max-h-[48px] w-auto object-contain" loading="lazy" />
						<span class="text-xs text-olive-600 font-medium text-center">UNICEF</span>
					</a>
				</div>
			</div>
		</section>

		<!-- Back to main page link -->
		<div class="text-center mt-8">
			<a 
				href={`${baseUrl}/`}
				class="inline-flex items-center gap-2 text-olive-600 hover:text-olive-700 text-sm font-medium transition-colors"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
				</svg>
				Voltar à página principal
			</a>
		</div>
	</main>
</Layout>
