---
import Layout from '../layouts/Layout.astro';
import IntroScreen from '../components/IntroScreen.astro';
import QuizGate from '../components/QuizGate.astro';
import HeroModern from '../components/HeroModern.astro';
import CountdownModern from '../components/CountdownModern.astro';
import Ceremony from '../sections/Ceremony.astro';
import Timeline from '../sections/Timeline.astro';
import LoveStory from '../sections/LoveStory.astro';
import Gallery from '../sections/Gallery.astro';
import GiftList from '../sections/GiftList.astro';
import Location from '../sections/Location.astro';
import Faq from '../sections/Faq.astro';
import RSVP from '../sections/RSVP.astro';
import Contact from '../sections/Contact.astro';
---

<Layout title="Tânia & Miguel — 28 de Maio de 2027">
	<IntroScreen />
	<QuizGate />
	<div id="main-content" style="opacity: 0; pointer-events: none;">
		<HeroModern />
		<CountdownModern />
		<Ceremony />
		<Timeline />
		<LoveStory />
		<Gallery />
		<GiftList />
		<Location />
		<Faq />
		<RSVP />
		<Contact />
	</div>
</Layout>
