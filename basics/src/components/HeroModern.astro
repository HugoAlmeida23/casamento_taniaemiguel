---
// Hero section — Plaza de España (Seville) illustration with elegant wedding overlay
// Design: names in signature font, date in boxes, tagline at bottom
---

<section class="relative min-h-screen flex flex-col items-center justify-start overflow-hidden">
	<!-- Background: Plaza de España illustration -->
	<div class="absolute inset-0">
		<img 
			src={`${import.meta.env.BASE_URL}/images/plaza-espana-seville.png`}
			alt="Ilustração da Plaza de España em Sevilha" 
			class="w-full h-full object-cover"
			loading="eager"
		/>
	</div>

	<!-- Content overlay -->
	<div class="relative z-10 text-center px-6 max-w-3xl mx-auto flex flex-col items-center pt-16 md:pt-20">
		<!-- Welcome text -->
		<p class="text-lg md:text-2xl text-gray-800 font-medium mb-8" style="font-family: 'Montserrat', sans-serif;">
			Bem-vindos ao nosso casamento!
		</p>

		<!-- Names in signature font — compact layout with "e" inline -->
		<div class="text-center" style="font-family: 'Mrs Saint Delafield', cursive;">
			<p class="text-6xl sm:text-7xl md:text-9xl text-gray-800 leading-none mb-0">Tânia</p>
			<p class="text-3xl sm:text-4xl md:text-5xl text-gray-800 leading-none ml-16 sm:ml-20 md:ml-28 -mt-2 md:-mt-4 mb-0">e</p>
			<p class="text-6xl sm:text-7xl md:text-9xl text-gray-800 leading-none -mt-2 md:-mt-4">Miguel</p>
		</div>

		<!-- Date in styled format: lines above/below "Maio" and "2027", "28" large in center with "12h30" below -->
		<div class="flex items-center justify-center gap-4 md:gap-6 mt-10 mb-8">
			<!-- Maio -->
			<div class="flex flex-col items-center">
				<span class="w-full h-px bg-gray-600 mb-1"></span>
				<span class="text-lg md:text-2xl text-gray-700 font-light tracking-wide px-2" style="font-family: 'Montserrat', sans-serif;">Maio</span>
				<span class="w-full h-px bg-gray-600 mt-1"></span>
			</div>
			<!-- 28 + 12h30 -->
			<div class="flex flex-col items-center">
				<span class="text-4xl md:text-5xl text-gray-800 font-light" style="font-family: 'Playfair Display', serif;">28</span>
				<span class="text-xs md:text-sm text-gray-500 font-light italic -mt-1">12h30</span>
			</div>
			<!-- 2027 -->
			<div class="flex flex-col items-center">
				<span class="w-full h-px bg-gray-600 mb-1"></span>
				<span class="text-lg md:text-2xl text-gray-700 font-light tracking-wide px-2" style="font-family: 'Montserrat', sans-serif;">2027</span>
				<span class="w-full h-px bg-gray-600 mt-1"></span>
			</div>
		</div>

		<!-- Tagline -->
		<p class="text-base md:text-lg text-gray-700 italic font-light" style="font-family: 'Playfair Display', serif;">
			Dois corações, uma só história.
		</p>

		<!-- Scroll hint -->
		<div class="mt-12 animate-bounce">
			<svg class="w-5 h-5 mx-auto text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
			</svg>
		</div>
	</div>
</section>
