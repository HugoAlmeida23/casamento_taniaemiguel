---
// Hero section — Plaza de España (Seville) illustration with elegant wedding overlay
// Design: names in signature font, date in boxes, tagline at bottom
// Contrast: text-shadow on all overlay text for readability over illustration
---

<section class="relative min-h-screen flex flex-col items-center justify-start overflow-hidden">
	<!-- Background: Plaza de España illustration -->
	<div class="absolute inset-0 z-0">
		<img 
			src={`/images/plaza-espana-seville.png`}
			alt="Ilustração da Plaza de España em Sevilha" 
			class="w-full h-full object-cover object-[90%_center]"
			loading="eager"
		/>
	</div>

	<!-- Content overlay — z-10 ensures text is above the illustration -->
	<div class="relative z-10 text-center px-6 max-w-3xl mx-auto flex flex-col items-center pt-16 md:pt-20 hero-text-overlay">
		<!-- Welcome text (sans-serif: Montserrat) -->
		<p class="text-lg md:text-xl lg:text-2xl text-gray-800 font-medium mb-8 font-montserrat">
			Bem-vindos ao nosso casamento!
		</p>

		<!-- Names in signature/cursive font (Whispering Signature) -->
		<div class="text-center font-cursive">
			<p class="text-[48px] sm:text-7xl md:text-[96px] leading-none mb-0">Tânia</p>
			<p class="text-3xl sm:text-4xl md:text-5xl text-gray-800 leading-none ml-16 sm:ml-20 md:ml-28 -mt-2 md:-mt-4 mb-0">e</p>
			<p class="text-[48px] sm:text-7xl md:text-[96px] leading-none -mt-2 md:-mt-4">Miguel</p>
		</div>

		<!-- Date in styled format (serif: Playfair Display) -->
		<div class="flex items-center justify-center gap-4 md:gap-6 mt-10 mb-8">
			<!-- Maio -->
			<div class="flex flex-col items-center">
				<span class="w-full h-px bg-gray-600 mb-1"></span>
				<span class="text-base md:text-xl lg:text-2xl text-gray-700 font-light tracking-wide px-2 font-playfair">Maio</span>
				<span class="w-full h-px bg-gray-600 mt-1"></span>
			</div>
			<!-- 28 -->
			<div class="flex flex-col items-center relative -top-1">
				<span class="text-4xl md:text-5xl text-gray-800 font-light font-playfair">28</span>
			</div>
			<!-- 2027 -->
			<div class="flex flex-col items-center">
				<span class="w-full h-px bg-gray-600 mb-1"></span>
				<span class="text-base md:text-xl lg:text-2xl text-gray-700 font-light tracking-wide px-2 font-playfair">2027</span>
				<span class="w-full h-px bg-gray-600 mt-1"></span>
			</div>
		</div>

		<!-- Tagline (serif: Playfair Display) -->
		<p class="text-base md:text-lg text-gray-700 italic font-light font-playfair">
			Dois corações, uma só história.
		</p>

		<!-- Scroll hint -->
		<div class="mt-12 animate-bounce">
			<svg class="w-5 h-5 mx-auto text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
			</svg>
		</div>
	</div>
</section>

<style>
	/* Font family utility classes */
	.font-cursive {
		font-family: 'Whispering Signature', cursive;
	}
	.font-playfair {
		font-family: 'Playfair Display', serif;
	}
	.font-montserrat {
		font-family: 'Montserrat', sans-serif;
	}

	/* Text contrast: text-shadow applied to all overlay text */
	.hero-text-overlay p,
	.hero-text-overlay span,
	.hero-text-overlay div {
		text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
	}

	/* Remove text-shadow from decorative lines and SVG */
	.hero-text-overlay svg,
	.hero-text-overlay .h-px {
		text-shadow: none;
	}

	/* Fix for small laptops (1366x768 and similar short viewports) */
	@media (max-height: 800px) and (min-width: 768px) {
		.hero-text-overlay {
			padding-top: 2rem;
		}
		.hero-text-overlay .font-cursive p {
			font-size: 72px;
		}
		.hero-text-overlay .font-cursive p:nth-child(2) {
			font-size: 2.25rem;
		}
	}
</style>
