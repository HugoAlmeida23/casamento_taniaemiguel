---
// Elegant countdown — olive/beige palette with sand texture background
---

<section class="wedding-section countdown-section">
	<div class="max-w-4xl mx-auto text-center">
		<div class="section-header">
			<h2 class="section-subtitle">Countdown</h2>
			<h2 class="section-title">PARA O DIA MAIS ESPECIAL DAS NOSSAS VIDAS</h2>
			<div class="ornament">
				<img
					src="/casamento_taniaemiguel/images/TM_LOGO.png"
					alt="TM logo"
					class="h-10 w-auto"
				/>
			</div>
		</div>

		<div id="countdown" class="flex justify-center items-start gap-6 md:gap-10">
			<div class="text-center">
				<div class="countdown-value" id="days">0</div>
				<div class="countdown-unit">Dias</div>
			</div>
			<div class="text-center">
				<div class="countdown-value" id="hours">0</div>
				<div class="countdown-unit">Horas</div>
			</div>
			<div class="text-center">
				<div class="countdown-value" id="minutes">0</div>
				<div class="countdown-unit">Minutos</div>
			</div>
			<div class="text-center">
				<div class="countdown-value" id="seconds">0</div>
				<div class="countdown-unit">Segundos</div>
			</div>
		</div>
	</div>
</section>

<script>
	function getLisbonDate(): { year: number; month: number; day: number } {
		const now = new Date();
		const formatter = new Intl.DateTimeFormat('en-CA', {
			timeZone: 'Europe/Lisbon',
			year: 'numeric',
			month: '2-digit',
			day: '2-digit',
		});
		// en-CA formats as YYYY-MM-DD
		const parts = formatter.format(now).split('-');
		return {
			year: parseInt(parts[0], 10),
			month: parseInt(parts[1], 10),
			day: parseInt(parts[2], 10),
		};
	}

	function isWeddingDayOrAfter(): boolean {
		const { year, month, day } = getLisbonDate();
		// Wedding date: 2027-05-28
		if (year > 2027) return true;
		if (year === 2027 && month > 5) return true;
		if (year === 2027 && month === 5 && day >= 28) return true;
		return false;
	}

	function showWeddingDayMessage() {
		const el = document.getElementById('countdown');
		if (el) {
			const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
			el.innerHTML = `
				<div class="text-center wedding-day-message">
					<p class="text-3xl md:text-5xl font-light text-gray-900" style="font-family: 'Playfair Display', serif;">
						HOJE É O GRANDE DIA
					</p>
					<a href="${baseUrl}/dia" class="wedding-day-link">
						Clica aqui para veres todos os detalhes!
					</a>
				</div>
			`;
		}
	}

	function updateCountdown() {
		if (isWeddingDayOrAfter()) {
			showWeddingDayMessage();
			return;
		}

		const weddingDate = new Date('2027-05-28T12:30:00').getTime();
		const now = new Date().getTime();
		const distance = weddingDate - now;

		if (distance < 0) {
			showWeddingDayMessage();
			return;
		}

		const days = Math.floor(distance / (1000 * 60 * 60 * 24));
		const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
		const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
		const seconds = Math.floor((distance % (1000 * 60)) / 1000);

		const daysEl = document.getElementById('days');
		const hoursEl = document.getElementById('hours');
		const minutesEl = document.getElementById('minutes');
		const secondsEl = document.getElementById('seconds');

		if (daysEl) daysEl.textContent = days.toString();
		if (hoursEl) hoursEl.textContent = hours.toString().padStart(2, '0');
		if (minutesEl) minutesEl.textContent = minutes.toString().padStart(2, '0');
		if (secondsEl) secondsEl.textContent = seconds.toString().padStart(2, '0');
	}

	updateCountdown();
	setInterval(updateCountdown, 1000);
</script>

<style>
	.countdown-section {
		background-image: url('/casamento_taniaemiguel/images/sand-texture.jpg');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.wedding-day-message {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.wedding-day-link {
		font-family: 'Montserrat', sans-serif;
		font-size: 1.125rem;
		color: #6b7c3e;
		text-decoration: underline;
		text-underline-offset: 4px;
		transition: color 0.2s ease;
	}

	.wedding-day-link:hover {
		color: #4a5a2b;
	}
</style>
