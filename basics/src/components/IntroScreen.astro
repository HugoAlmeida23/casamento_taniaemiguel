---
// Intro: envelope with seal (static) → tap → video plays → video ends → quiz
---

<div id="intro-screen" class="fixed inset-0 z-[200] flex items-center justify-center overflow-hidden select-none bg-black">
	
	<!-- Static envelope with seal (shown first) -->
	<div id="envelope-static" class="absolute inset-0 cursor-pointer" role="button" aria-label="Abrir convite" tabindex="0">
		<img 
			src={`${import.meta.env.BASE_URL}/images/envelope-with-seal.png`}
			alt="Convite de casamento" 
			class="w-full h-full object-cover object-center"
			loading="eager"
		/>
		<!-- Tap hint -->
		<p id="tap-hint" class="tap-hint">Toque para abrir</p>
	</div>

	<!-- Video (hidden initially, plays after tap) -->
	<video 
		id="envelope-video"
		class="w-full h-full object-cover opacity-0 pointer-events-none"
		style="object-position: center 55%;"
		muted
		playsinline
		preload="auto"
	>
		<source src={`${import.meta.env.BASE_URL}/images/envelope.mp4`} type="video/mp4" />
	</video>
</div>

<style>
	#intro-screen {
		transition: opacity 0.7s ease;
	}

	#intro-screen.dismissed {
		opacity: 0;
		pointer-events: none;
	}

	#envelope-static {
		z-index: 10;
		transition: opacity 0.3s ease;
	}

	#envelope-static.hidden {
		opacity: 0;
		pointer-events: none;
	}

	#envelope-video {
		transition: opacity 0.3s ease;
	}

	#envelope-video.visible {
		opacity: 1;
		pointer-events: auto;
	}

	.tap-hint {
		position: absolute;
		bottom: 2.5rem;
		left: 50%;
		transform: translateX(-50%);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.25em;
		color: rgba(255,255,255,0.6);
		z-index: 40;
		animation: hintPulse 2.5s ease-in-out infinite;
		text-shadow: 0 1px 3px rgba(0,0,0,0.5);
	}

	@keyframes hintPulse {
		0%, 100% { opacity: 0.4; transform: translateX(-50%) translateY(0); }
		50% { opacity: 0.8; transform: translateX(-50%) translateY(-3px); }
	}
</style>

<script>
	const intro = document.getElementById('intro-screen');
	const envelopeStatic = document.getElementById('envelope-static');
	const video = document.getElementById('envelope-video') as HTMLVideoElement;

	// Skip intro if user already completed the quiz
	if (localStorage.getItem('wedding_quiz_passed') === 'true') {
		intro?.remove();
		document.getElementById('quiz-gate')?.remove();
		document.getElementById('wtf-reveal')?.remove();
		const mainContent = document.getElementById('main-content');
		if (mainContent) {
			mainContent.style.opacity = '1';
			mainContent.style.pointerEvents = '';
		}
	} else {
		// Lock scroll while intro is showing
		document.body.style.overflow = 'hidden';
		document.documentElement.style.overflow = 'hidden';
		
		(window as any).__preventScroll = function(e: Event) {
			e.preventDefault();
		};
		document.addEventListener('wheel', (window as any).__preventScroll, { passive: false });
		document.addEventListener('touchmove', (window as any).__preventScroll, { passive: false });
	}

	let videoStarted = false;
	let dismissed = false;

	function startVideo() {
		if (videoStarted) return;
		videoStarted = true;

		// Hide static envelope, show video
		envelopeStatic?.classList.add('hidden');
		video?.classList.add('visible');
		video?.play();
	}

	function dismissIntro() {
		if (dismissed) return;
		dismissed = true;

		if (video) video.pause();

		// Show quiz before fading out
		setTimeout(() => {
			if (typeof (window as any).showQuizGate === 'function') {
				(window as any).showQuizGate();
			}
		}, 100);

		// Fade out intro
		setTimeout(() => {
			intro?.classList.add('dismissed');
		}, 400);

		// Remove from DOM
		setTimeout(() => {
			intro?.remove();
		}, 1100);
	}

	// Tap on envelope → start video
	envelopeStatic?.addEventListener('click', (e) => {
		e.stopPropagation();
		startVideo();
	});

	envelopeStatic?.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' || e.key === ' ') {
			e.preventDefault();
			startVideo();
		}
	});

	// When video ends → transition to quiz
	video?.addEventListener('ended', () => {
		dismissIntro();
	});
</script>
