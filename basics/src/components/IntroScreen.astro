---
// Full-screen realistic envelope with gold wax seal
// Uses actual images: envelope-background.jpg and wax-seal.png
// The envelope image covers the full viewport, seal sits at the flap junction
// Tap → seal shakes & fades → envelope fades out → quiz appears
---

<div id="intro-screen" class="fixed inset-0 z-[200] flex items-center justify-center overflow-hidden cursor-pointer select-none" role="button" aria-label="Abrir convite" tabindex="0">
	
	<!-- Full-screen envelope photo — covers entire viewport -->
	<div id="envelope-bg" class="absolute inset-0">
		<img 
			src={`${import.meta.env.BASE_URL}/images/envelope-background.jpg`}
			alt="" 
			class="w-full h-full object-cover object-center"
			loading="eager"
		/>
	</div>

	<!-- Realistic gold wax seal — positioned at the flap junction point -->
	<div id="wax-seal" class="wax-seal">
		<img 
			src={`${import.meta.env.BASE_URL}/images/wax-seal.png`}
			alt="Selo de cera dourado T&M" 
			class="seal-img"
			loading="eager"
		/>
		<!-- T & M monogram — embossed into the wax -->
		<div class="seal-monogram-wrap">
			<span class="seal-monogram">T</span>
			<span class="seal-monogram seal-amp">&</span>
			<span class="seal-monogram">M</span>
		</div>
	</div>

	<!-- Tap hint -->
	<p id="tap-hint" class="tap-hint">Toque para abrir</p>
</div>

<style>
	/* ============================================
	   ENVELOPE — single full-screen image
	   ============================================ */
	#envelope-bg {
		z-index: 2;
		transition: opacity 0.8s ease;
	}

	#envelope-bg.fade-out {
		opacity: 0;
	}

	/* ============================================
	   WAX SEAL — large, at the flap junction
	   Adjust top/left to match where the flap point
	   lands on your specific envelope image.
	   ============================================ */
	.wax-seal {
		position: absolute;
		top: 80%;
		left: 51%;
		transform: translate(-50%, -50%);
		z-index: 30;
		width: 200px;
		height: 200px;
		transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.5s ease;
	}

	@media (min-width: 640px) {
		.wax-seal {
			width: 320px;
			height: 320px;
		}
	}

	@media (min-width: 1024px) {
		.wax-seal {
			width: 380px;
			height: 380px;
		}
	}

	.seal-img {
		width: 100%;
		height: 100%;
		display: block;
		max-width: none;
		filter: drop-shadow(0 8px 30px rgba(0,0,0,0.5)) drop-shadow(0 2px 6px rgba(0,0,0,0.3));
	}

	/* Monogram wrapper — centered on the seal */
	.seal-monogram-wrap {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		display: flex;
		align-items: baseline;
		gap: 1px;
		z-index: 2;
		pointer-events: none;
	}

	/* Embossed text effect — looks pressed/stamped into wax */
	.seal-monogram {
		font-family: 'Times New Roman', Times, serif;
		font-weight: 700;
		font-size: 2.4rem;
		color: transparent;
		background: linear-gradient(180deg, rgba(120,80,20,0.7) 0%, rgba(180,130,50,0.9) 40%, rgba(220,180,80,0.6) 100%);
		-webkit-background-clip: text;
		background-clip: text;
		text-shadow: 
			0 -1px 1px rgba(255,240,180,0.5),
			0 1px 2px rgba(0,0,0,0.6),
			0 2px 4px rgba(0,0,0,0.3),
			0 0 6px rgba(160,120,40,0.2);
		letter-spacing: 0.02em;
		line-height: 1;
	}

	.seal-amp {
		font-size: 1.4rem;
		font-style: italic;
		margin: 0 3px;
		vertical-align: baseline;
		position: relative;
		top: -2px;
	}

	@media (min-width: 640px) {
		.seal-monogram {
			font-size: 3.2rem;
		}
		.seal-amp {
			font-size: 1.8rem;
			top: -3px;
		}
	}

	@media (min-width: 1024px) {
		.seal-monogram {
			font-size: 3.8rem;
		}
		.seal-amp {
			font-size: 2.1rem;
			top: -4px;
		}
	}

	/* Subtle pulse glow around seal */
	.wax-seal::after {
		content: '';
		position: absolute;
		inset: -10px;
		border-radius: 50%;
		border: 1.5px solid rgba(212, 168, 83, 0.2);
		animation: sealPulse 3s ease-in-out infinite;
	}

	@keyframes sealPulse {
		0%, 100% { transform: scale(1); opacity: 0.3; }
		50% { transform: scale(1.05); opacity: 0.7; }
	}

	/* Seal shake before break */
	.wax-seal.shake {
		animation: sealShake 0.5s ease;
	}

	@keyframes sealShake {
		0%, 100% { transform: translate(-50%, -50%) rotate(0deg); }
		20% { transform: translate(-50%, -50%) rotate(-4deg) scale(1.03); }
		40% { transform: translate(-50%, -50%) rotate(4deg) scale(1.05); }
		60% { transform: translate(-50%, -50%) rotate(-3deg) scale(1.03); }
		80% { transform: translate(-50%, -50%) rotate(2deg) scale(1.01); }
	}

	.wax-seal.broken {
		transform: translate(-50%, -50%) scale(1.3);
		opacity: 0;
		transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
	}

	/* ============================================
	   DISMISS
	   ============================================ */
	#intro-screen.dismissed {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.7s ease;
	}

	/* ============================================
	   TAP HINT
	   ============================================ */
	.tap-hint {
		position: absolute;
		bottom: 2.5rem;
		left: 50%;
		transform: translateX(-50%);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.25em;
		color: rgba(255,255,255,0.5);
		z-index: 40;
		animation: hintPulse 2.5s ease-in-out infinite;
		transition: opacity 0.4s ease;
		text-shadow: 0 1px 3px rgba(0,0,0,0.3);
	}

	@keyframes hintPulse {
		0%, 100% { opacity: 0.4; transform: translateX(-50%) translateY(0); }
		50% { opacity: 0.7; transform: translateX(-50%) translateY(-3px); }
	}
</style>

<script>
	const intro = document.getElementById('intro-screen');
	const seal = document.getElementById('wax-seal');
	const envelopeBg = document.getElementById('envelope-bg');
	const hint = document.getElementById('tap-hint');

	let opened = false;

	function openEnvelope() {
		if (opened) return;
		opened = true;

		if (hint) hint.style.opacity = '0';

		// Step 1: Seal shakes
		seal?.classList.add('shake');

		// Step 2: Seal fades out (500ms)
		setTimeout(() => {
			seal?.classList.remove('shake');
			seal?.classList.add('broken');
		}, 500);

		// Step 3: Show quiz BEFORE envelope fades (so no flash of main content)
		setTimeout(() => {
			if (typeof (window as any).showQuizGate === 'function') {
				(window as any).showQuizGate();
			}
		}, 800);

		// Step 4: Envelope fades out (1200ms) — quiz is already visible behind it
		setTimeout(() => {
			envelopeBg?.classList.add('fade-out');
		}, 1200);

		// Step 5: Dismiss intro (1800ms)
		setTimeout(() => {
			intro?.classList.add('dismissed');
		}, 1800);

		// Step 6: Remove from DOM
		setTimeout(() => {
			intro?.remove();
		}, 2500);
	}

	// Lock scroll while intro is showing
	document.body.style.overflow = 'hidden';
	document.documentElement.style.overflow = 'hidden';
	
	(window as any).__preventScroll = function(e: Event) {
		e.preventDefault();
	};
	document.addEventListener('wheel', (window as any).__preventScroll, { passive: false });
	document.addEventListener('touchmove', (window as any).__preventScroll, { passive: false });

	intro?.addEventListener('click', (e) => {
		e.stopPropagation();
		e.stopImmediatePropagation();
		openEnvelope();
	});

	intro?.addEventListener('mouseup', (e) => { e.stopPropagation(); });
	intro?.addEventListener('touchend', (e) => { e.stopPropagation(); });

	intro?.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' || e.key === ' ') {
			e.preventDefault();
			openEnvelope();
		}
	});
</script>
