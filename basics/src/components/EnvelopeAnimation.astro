---
// Intro: Video_inicial.mp4 paused → tap anywhere to play → on end → quiz gate.
const base = import.meta.env.BASE_URL;
const videoSrc = `${base}images/Video_inicial.mp4`;
---

<div
	id="intro-screen"
	class="fixed inset-0 z-[200] overflow-hidden select-none bg-black cursor-pointer"
>
	<video
		id="intro-video"
		class="absolute inset-0 w-full h-full object-cover"
		style="object-position: 48% center; margin:0; padding:0;"
		muted
		playsinline
		preload="auto"
		style="margin:0; padding:0;"
	>
		<source src={videoSrc} type="video/mp4" />
	</video>
</div>

<style>
	#intro-screen {
		transition: opacity 0.6s ease, filter 0.9s ease;
		height: 100vh;
		height: 100dvh;
		width: 100vw;
		touch-action: none;
		overscroll-behavior: none;
	}

	#intro-screen.vanishing {
		filter: blur(12px) brightness(1.25);
		opacity: 0.6;
	}

	#intro-screen.dismissed {
		opacity: 0;
		pointer-events: none;
	}
</style>

<script>
	const intro = document.getElementById('intro-screen');
	const video = document.getElementById('intro-video') as HTMLVideoElement | null;

	// Skip intro if the guest already passed the quiz
	if (localStorage.getItem('wedding_quiz_passed') === 'true') {
		intro?.remove();
		document.getElementById('quiz-gate')?.remove();
		document.getElementById('wtf-reveal')?.remove();
		const mainContent = document.getElementById('main-content');
		if (mainContent) {
			mainContent.style.opacity = '1';
			mainContent.style.pointerEvents = '';
		}
	} else {
		// Lock scroll while the intro is showing
		document.body.style.overflow = 'hidden';
		document.documentElement.style.overflow = 'hidden';

		(window as any).__preventScroll = function (e: Event) {
			e.preventDefault();
		};
		document.addEventListener('wheel', (window as any).__preventScroll, { passive: false });
		document.addEventListener('touchmove', (window as any).__preventScroll, { passive: false });
	}

	let videoStarted = false;
	let dismissed = false;
	let vanishingStarted = false;

	function startVideo() {
		if (videoStarted) return;
		videoStarted = true;
		video?.play().catch(() => {});
	}

	function startVanishing() {
		if (vanishingStarted) return;
		vanishingStarted = true;
		intro?.classList.add('vanishing');
	}

	function dismissIntro() {
		if (dismissed) return;
		dismissed = true;

		video?.pause();
		startVanishing();

		if (typeof (window as any).showQuizGate === 'function') {
			(window as any).showQuizGate();
		}

		setTimeout(() => {
			intro?.classList.add('dismissed');
			setTimeout(() => intro?.remove(), 700);
		}, 400);
	}

	// Tap / click anywhere → start video (first tap) or skip (subsequent)
	intro?.addEventListener('click', () => {
		if (!videoStarted) {
			startVideo();
		} else {
			dismissIntro();
		}
	});

	intro?.addEventListener('touchend', (e) => {
		e.preventDefault();
		if (!videoStarted) {
			startVideo();
		} else {
			dismissIntro();
		}
	}, { passive: false });

	document.addEventListener('keydown', (e) => {
		if (dismissed) return;
		if (e.key === 'Enter' || e.key === ' ') {
			e.preventDefault();
			if (!videoStarted) {
				startVideo();
			} else {
				dismissIntro();
			}
		}
	});

	// Start blur ~1s before the video ends
	video?.addEventListener('timeupdate', () => {
		if (video && video.duration && video.currentTime >= video.duration - 1) {
			startVanishing();
		}
	});

	// When the video finishes → go to quiz
	video?.addEventListener('ended', dismissIntro);
</script>
