---
// Quiz gate - "Quando e onde é que o Miguel pediu oficialmente a Tânia em namoro?"
---

<div id="quiz-gate" class="fixed inset-0 z-[150] flex items-center justify-center bg-[#faf7f0] opacity-0 pointer-events-none transition-opacity duration-600">
	<div class="max-w-md w-full mx-6 text-center">
		<!-- Decorative top -->
		<div class="mb-8">
			<span class="text-3xl mb-4 block">🌿</span>
			<p class="text-xs uppercase tracking-[0.3em] text-olive-500 mb-3">Antes de entrar...</p>
			<h2 class="text-2xl sm:text-3xl font-light text-gray-900" style="font-family: 'Playfair Display', serif;">
				Prova que nos conheces!
			</h2>
			<div class="w-12 h-px bg-beige-400 mx-auto mt-4"></div>
		</div>

		<!-- Question -->
		<div class="mb-8">
			<p class="text-base sm:text-lg text-gray-700 font-medium leading-relaxed">
				Quando e onde é que o Miguel pediu oficialmente a Tânia em namoro?
			</p>
		</div>

		<!-- Options -->
		<div class="grid grid-cols-1 gap-3" id="quiz-options">
			<button class="quiz-option" data-correct="false">
				<span>Viagem de finalistas (Gandia), 07/04/2017</span>
			</button>
			<button class="quiz-option" data-correct="false">
				<span>Escola Secundária da Trofa, 07/10/2014</span>
			</button>
			<button class="quiz-option" data-correct="true">
				<span>Sevilha, 05/10/2024</span>
			</button>
			<button class="quiz-option" data-correct="false">
				<span>Parque Nossa Senhora das Dores, 05/04/2015</span>
			</button>
		</div>

		<!-- Feedback message -->
		<div id="quiz-feedback" class="mt-6 text-sm font-medium opacity-0 transition-opacity duration-300">
			<p id="quiz-feedback-text"></p>
		</div>

	</div>
</div>

<!-- Full-screen WTF reveal (tap to advance) -->
<div id="wtf-reveal" class="fixed inset-0 z-[160] flex flex-col items-center justify-center bg-[#faf7f0] opacity-0 pointer-events-none transition-opacity duration-500 cursor-pointer" role="button" tabindex="0" aria-label="Toca para continuar">
	<div class="text-center px-6 max-w-lg mx-auto">
		<div id="wtf-img-wrap" class="opacity-0 rounded-2xl overflow-hidden shadow-2xl mx-auto max-w-sm md:max-w-md" style="transform: translateY(40px);">
			<img 
				id="wtf-img"
				src=""
				alt="Visita Rio Maior – Almeirim 2016"
				class="w-full h-auto"
			/>
		</div>
		<p id="wtf-tap-hint" class="mt-6 text-sm text-gray-500 opacity-0 transition-opacity duration-500">Toca para continuar</p>
	</div>
</div>

<style>
	#quiz-gate.visible {
		opacity: 1;
		pointer-events: auto;
	}

	#quiz-gate.dismissed {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.8s ease;
	}

	.quiz-option {
		@apply w-full px-5 py-4 border border-beige-300 rounded-xl text-sm text-gray-700 font-medium text-left transition-all duration-300 hover:border-olive-400 hover:bg-olive-50;
		pointer-events: none;
	}

	#quiz-gate.visible .quiz-option {
		pointer-events: auto;
	}

	.quiz-option:active {
		transform: scale(0.98);
	}

	.quiz-option.correct {
		@apply border-olive-500 bg-olive-50 text-olive-700;
		animation: correctPulse 0.5s ease;
	}

	.quiz-option.wrong {
		@apply border-red-300 bg-red-50 text-red-600;
		animation: shake 0.5s ease;
	}

	.quiz-option:disabled {
		@apply cursor-not-allowed opacity-60;
	}

	@keyframes shake {
		0%, 100% { transform: translateX(0); }
		20% { transform: translateX(-6px); }
		40% { transform: translateX(6px); }
		60% { transform: translateX(-4px); }
		80% { transform: translateX(4px); }
	}

	@keyframes correctPulse {
		0% { transform: scale(1); }
		50% { transform: scale(1.02); }
		100% { transform: scale(1); }
	}

	.quiz-skip-link {
		@apply inline-flex items-center justify-center text-sm text-gray-500 underline underline-offset-4 decoration-gray-300 transition-colors duration-200 hover:text-olive-600 hover:decoration-olive-400 focus:text-olive-600 focus:decoration-olive-400 focus:outline-none focus:ring-2 focus:ring-olive-400 focus:ring-offset-2 rounded;
		min-width: 44px;
		min-height: 44px;
		padding: 10px 16px;
		pointer-events: none;
	}

	#quiz-gate.visible .quiz-skip-link {
		pointer-events: auto;
	}

	/* WTF Reveal animations */
	#wtf-reveal.visible {
		opacity: 1;
		pointer-events: auto;
	}

	#wtf-text.animate {
		opacity: 1;
		transform: scale(1);
		transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	#wtf-img-wrap.animate {
		opacity: 1;
		transform: translateY(0);
		transition: opacity 0.5s ease 0.3s, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s;
	}
</style>

<script>
	const quizGate = document.getElementById('quiz-gate');
	const options = document.querySelectorAll('.quiz-option');
	const feedback = document.getElementById('quiz-feedback');
	const feedbackText = document.getElementById('quiz-feedback-text');
	const wtfReveal = document.getElementById('wtf-reveal');
	const wtfText = document.getElementById('wtf-text');
	const wtfImgWrap = document.getElementById('wtf-img-wrap');
	const wtfImg = document.getElementById('wtf-img') as HTMLImageElement;
	const wtfTapHint = document.getElementById('wtf-tap-hint');
	const skipLink = document.getElementById('quiz-skip-link');

	let answered = false;
	let interactive = false;
	let waitingForTap = false;

	// State machine:
	// CheckStorage → ShowQuiz → CorrectFeedback → WTFReveal → WaitingForTap → Dismissed
	//                ShowQuiz → WrongFeedback → ShowQuiz (retry)

	window.showQuizGate = function() {
		quizGate?.classList.add('visible');
		setTimeout(() => {
			interactive = true;
		}, 600);
	};

	// Dismiss WTF overlay and reveal main content
	function dismissOverlay() {
		const mainContent = document.getElementById('main-content');
		if (mainContent) {
			mainContent.style.transition = 'opacity 0.6s ease';
			mainContent.style.opacity = '1';
			mainContent.style.pointerEvents = '';
		}
		if (wtfReveal) {
			wtfReveal.style.transition = 'opacity 0.8s ease';
			wtfReveal.style.opacity = '0';
			wtfReveal.style.pointerEvents = 'none';
		}
		document.body.style.overflow = '';
		document.documentElement.style.overflow = '';
		if ((window as any).__preventScroll) {
			document.removeEventListener('wheel', (window as any).__preventScroll);
			document.removeEventListener('touchmove', (window as any).__preventScroll);
		}
		window.scrollTo(0, 0);

		// Clean up DOM after fade completes
		setTimeout(() => {
			quizGate?.remove();
			wtfReveal?.remove();
		}, 1000);
	}

	// Skip link: dismiss quiz directly without WTF reveal
	function handleSkip() {
		if (answered) return;
		answered = true;

		// Persist bypass in localStorage
		try {
			localStorage.setItem('wedding_quiz_passed', 'true');
		} catch (e) {
			// localStorage unavailable (private browsing) — continue without persistence
		}

		// Dismiss quiz gate overlay directly (bypass WTF reveal)
		if (quizGate) {
			quizGate.style.transition = 'opacity 0.8s ease';
			quizGate.style.opacity = '0';
			quizGate.style.pointerEvents = 'none';
		}

		// Reveal main content
		const mainContent = document.getElementById('main-content');
		if (mainContent) {
			mainContent.style.transition = 'opacity 0.6s ease';
			mainContent.style.opacity = '1';
			mainContent.style.pointerEvents = '';
		}

		// Unlock scroll
		document.body.style.overflow = '';
		document.documentElement.style.overflow = '';
		if ((window as any).__preventScroll) {
			document.removeEventListener('wheel', (window as any).__preventScroll);
			document.removeEventListener('touchmove', (window as any).__preventScroll);
		}
		window.scrollTo(0, 0);

		// Clean up DOM after transitions complete
		setTimeout(() => {
			quizGate?.remove();
			wtfReveal?.remove();
		}, 1000);
	}

	// Attach skip link event listeners
	if (skipLink) {
		skipLink.addEventListener('click', handleSkip);
		skipLink.addEventListener('keydown', (e: KeyboardEvent) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				handleSkip();
			}
		});
	}

	// Tap-to-advance: listen for click/tap and keyboard on the WTF overlay
	function handleWtfTap(e: Event) {
		if (!waitingForTap) return;
		e.preventDefault();
		waitingForTap = false;
		dismissOverlay();
	}

	if (wtfReveal) {
		wtfReveal.addEventListener('click', handleWtfTap);
		wtfReveal.addEventListener('keydown', (e: KeyboardEvent) => {
			if (waitingForTap && (e.key === 'Enter' || e.key === ' ')) {
				e.preventDefault();
				waitingForTap = false;
				dismissOverlay();
			}
		});
	}

	options.forEach(btn => {
		btn.addEventListener('click', () => {
			if (answered || !interactive) return;

			const isCorrect = btn.getAttribute('data-correct') === 'true';

			if (isCorrect) {
				answered = true;
				btn.classList.add('correct');
				
				// Save to localStorage so we don't ask again
				try {
					localStorage.setItem('wedding_quiz_passed', 'true');
				} catch (e) {
					// localStorage unavailable (private browsing) — continue without persistence
				}
				
				options.forEach(b => (b as HTMLButtonElement).disabled = true);

				if (feedback) feedback.style.opacity = '1';
				if (feedbackText) {
					feedbackText.textContent = '🌿 Correto!';
					feedbackText.className = 'text-olive-600';
				}

				// Set the WTF image
				const baseUrl = (document.querySelector('meta[name="base-url"]') as HTMLMetaElement)?.content || '';
				if (wtfImg) {
					wtfImg.src = `${baseUrl}/images/19_wtf.jpg`;
				}

				// After 800ms "Correto!" feedback, transition to WTF reveal
				setTimeout(() => {
					quizGate?.classList.add('dismissed');
					wtfReveal?.classList.add('visible');

					// Animate text in
					setTimeout(() => wtfText?.classList.add('animate'), 100);
					// Animate photo in 300ms after text
					setTimeout(() => {
						wtfImgWrap?.classList.add('animate');
						// Show tap hint after photo appears and enable tap-to-advance
						setTimeout(() => {
							if (wtfTapHint) wtfTapHint.style.opacity = '1';
							waitingForTap = true;
						}, 600);
					}, 400);
				}, 800);

			} else {
				btn.classList.add('wrong');
				
				if (feedback) feedback.style.opacity = '1';
				if (feedbackText) {
					feedbackText.textContent = 'Não é essa! Tenta outra vez.';
					feedbackText.className = 'text-red-500';
				}

				// Shake animation (1500ms) then reset
				setTimeout(() => {
					btn.classList.remove('wrong');
					if (feedback) feedback.style.opacity = '0';
				}, 1500);
			}
		});
	});
</script>
